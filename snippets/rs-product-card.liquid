{% comment %}
  Right Shift - Product Card Snippet
  File: snippets/rs-product-card.liquid

  USAGE:
    {% render 'rs-product-card',
        product: product,
        card_bg: card_bg,
        section: section
    %}

  VARIABLES:
    product  → Shopify product object (required)
    card_bg  → Card image area background color string e.g. '#f5b800'
               (optional — falls back to section.settings.card_color_1)
    section  → Section object for colors, radius etc. (required)

  CARD COLORS (rotate karte hain — yellow, blue, green):
    Caller se card_bg pass karo, ya section.settings.card_color_1/2/3 use karo.
    Example loop in section:
      {%- assign ci = forloop.index0 | modulo: 3 -%}
      {%- if ci == 0 -%}{%- assign cbg = section.settings.card_color_1 -%}
      {%- elsif ci == 1 -%}{%- assign cbg = section.settings.card_color_2 -%}
      {%- else -%}{%- assign cbg = section.settings.card_color_3 -%}{%- endif -%}
      {% render 'rs-product-card', product: product, card_bg: cbg, section: section %}
{% endcomment %}

{%- liquid
  assign bg     = card_bg | default: section.settings.card_color_1 | default: '#f5b800'
  assign radius = section.settings.card_radius | default: 14
  assign atc_bg     = section.settings.atc_bg | default: '#1a1a1a'
  assign atc_color  = section.settings.atc_color | default: '#ffffff'
  assign buy_bg     = section.settings.buy_bg | default: '#e0c97a'
  assign buy_color  = section.settings.buy_color | default: '#1a1a1a'
  assign title_color = section.settings.product_title_color | default: '#1a1a1a'
  assign desc_color  = section.settings.product_desc_color  | default: '#666666'
  assign price_color = section.settings.price_color | default: '#1a1a1a'
-%}

<div class="rs-card" style="border-radius:{{ radius }}px;overflow:hidden;display:flex;flex-direction:column;background:#fff;height:100%;">

  {%- comment -%} Image Area with colored background {%- endcomment -%}
  <a href="{{ product.url }}"
     style="display:block;background:{{ bg }};overflow:hidden;border-radius:{{ radius }}px {{ radius }}px 0 0;text-decoration:none;position:relative;">
    {% if product.featured_image != blank %}
      <img
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
        class="rs-cimg"
        style="width:100%;aspect-ratio:1/1;object-fit:contain;display:block;padding:18px;box-sizing:border-box;">
    {% else %}
      <div style="width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.55);font-size:13px;text-align:center;">
        No Image
      </div>
    {% endif %}
  </a>

  {%- comment -%} Add to Cart + Buy Now {%- endcomment -%}
  <div style="display:grid;grid-template-columns:1fr 1fr;">
    <button
      onclick="rsATC('{{ product.variants.first.id }}', this)"
      style="background:{{ atc_bg }};color:{{ atc_color }};border:none;padding:11px 8px;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:0.3px;transition:opacity .2s;"
      onmouseover="this.style.opacity='.8'"
      onmouseout="this.style.opacity='1'">
      Add to cart
    </button>
    <a
      href="{{ product.url }}?buy=true"
      style="background:{{ buy_bg }};color:{{ buy_color }};padding:11px 8px;font-size:12px;font-weight:700;text-decoration:none;text-align:center;display:flex;align-items:center;justify-content:center;letter-spacing:0.3px;transition:opacity .2s;"
      onmouseover="this.style.opacity='.8'"
      onmouseout="this.style.opacity='1'">
      Buy now
    </a>
  </div>

  {%- comment -%} Product Info {%- endcomment -%}
  <div style="padding:12px 14px 16px;flex:1;display:flex;flex-direction:column;">
    <h3 style="color:{{ title_color }};font-size:14px;font-weight:700;margin:0 0 5px;line-height:1.35;">
      <a href="{{ product.url }}" style="color:inherit;text-decoration:none;">{{ product.title }}</a>
    </h3>

    {% if product.description != blank %}
      <p style="color:{{ desc_color }};font-size:12px;margin:0 0 10px;line-height:1.55;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;flex:1;">
        {{ product.description | strip_html | truncate: 90 }}
      </p>
    {% endif %}

    <div style="color:{{ price_color }};font-size:15px;font-weight:800;margin-top:auto;">
      {{ product.price | money }}
      {% if product.compare_at_price > product.price %}
        <span style="color:#aaa;font-size:12px;font-weight:400;text-decoration:line-through;margin-left:5px;">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>
  </div>

</div>

{%- comment -%} ATC JS — loads once only on page {%- endcomment -%}
<script>
if (typeof rsATC === 'undefined') {
  function rsATC(variantId, btn) {
    var orig = btn.textContent;
    btn.textContent = 'Adding...';
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      btn.textContent = 'Added ✓';
      document.dispatchEvent(new CustomEvent('cart:updated'));
      setTimeout(function() { btn.textContent = orig; btn.disabled = false; }, 1600);
    })
    .catch(function() {
      btn.textContent = 'Error!';
      setTimeout(function() { btn.textContent = orig; btn.disabled = false; }, 1600);
    });
  }
}
</script>

<style>
  .rs-cimg { transition: transform .35s ease; }
  .rs-card:hover .rs-cimg { transform: scale(1.05); }
</style>
