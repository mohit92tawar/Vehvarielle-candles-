<!-- ═══ FIREBASE + FIRESTORE SCRIPT ═══ -->
<script type="module">
  const FIREBASE_CONFIG = {
    apiKey:            "AIzaSyA-kUPK37duIL2OAE1uojfauxPV7HryTg4",
    authDomain:        "right-shift-health.firebaseapp.com",
    projectId:         "right-shift-health",
    storageBucket:     "right-shift-health.firebasestorage.app",
    messagingSenderId: "13670469414",
    appId:             "1:13670469414:web:f0949b066b363de928fbe7"
  };
  const SENDGRID_WORKER_URL = "https://rs-email-sender.vishalchouhan-web.workers.dev";

  import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getAuth, GoogleAuthProvider, signInWithPopup,
           RecaptchaVerifier, signInWithPhoneNumber,
           sendSignInLinkToEmail, isSignInWithEmailLink,
           signInWithEmailLink, onAuthStateChanged }
                                 from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, updateDoc, arrayUnion, serverTimestamp }
                                 from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const app = getApps().length ? getApp() : initializeApp(FIREBASE_CONFIG);

  const firebaseAuth   = getAuth(app);
  const db             = getFirestore(app);
  const googleProvider = new GoogleAuthProvider();

  let rsState = {
    confirmationResult: null,
    otpMode: null,
    otpTarget: null,
    userName: '',
    totalScore: 0,
    scoreBreakdown: [],
    timerInterval: null
  };

  function showError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg; el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 6000);
  }
  function setBtnLoading(btnId, loading, text) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.textContent = loading ? '⏳ Please wait...' : text;
    btn.disabled = loading;
    btn.classList.toggle('active', !loading);
  }
  function startOtpTimer(sid) {
    clearInterval(rsState.timerInterval);
    let count = 30;
    const countEl = document.getElementById('rs-timer-count-' + sid);
    const timerEl = document.getElementById('rs-resend-timer-' + sid);
    const resendEl = document.getElementById('rs-resend-btn-' + sid);
    if (timerEl) timerEl.style.display = 'inline';
    if (resendEl) resendEl.style.display = 'none';
    rsState.timerInterval = setInterval(() => {
      count--;
      if (countEl) countEl.textContent = count;
      if (count <= 0) {
        clearInterval(rsState.timerInterval);
        if (timerEl) timerEl.style.display = 'none';
        if (resendEl) resendEl.style.display = 'inline';
      }
    }, 1000);
  }

  async function saveScoreToFirestore(user, score, breakdown) {
    try {
      const userRef = doc(db, 'users', user.uid);
      const snap = await getDoc(userRef);
      const now = new Date().toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });

      if (!snap.exists()) {
        const nameParts = (user.displayName || '').split(' ');
        await setDoc(userRef, {
          firstName: nameParts[0] || '',
          lastName: nameParts.slice(1).join(' ') || '',
          email: user.email || '',
          phone: user.phoneNumber || '',
          photoURL: user.photoURL || '',
          age: '', gender: '', city: '',
          scores: [{ score, breakdown, date: serverTimestamp(), takenAt: now }],
          activity: [
            { icon: '👋', title: 'Joined Right Shift', sub: now },
            { icon: '🏆', title: `Health quiz completed — Score: ${score}/100`, sub: now }
          ],
          notifications: [
            { icon: '🎉', title: 'Welcome to Right Shift!', time: now, read: false },
            { icon: '📊', title: `Your health score: ${score}/100`, time: now, read: false }
          ],
          createdAt: serverTimestamp()
        });
      } else {
        await updateDoc(userRef, {
          scores: arrayUnion({ score, breakdown, date: serverTimestamp(), takenAt: now }),
          activity: arrayUnion({ icon: '🏆', title: `Health quiz completed — Score: ${score}/100`, sub: now }),
          notifications: arrayUnion({ icon: '📊', title: `Your new health score: ${score}/100`, time: now, read: false })
        });
      }
    } catch(e) {
      console.warn('Firestore save error:', e);
    }
  }

  async function sendScoreEmail(toEmail, name, score, breakdown) {
    try {
      await fetch(SENDGRID_WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: toEmail, name, score, breakdown })
      });
    } catch(e) { console.warn('Email send failed:', e); }
  }

  async function rsAuthSuccess(sid, user) {
    const email    = user.email || '';
    const name     = rsState.userName || user.displayName || 'User';
    const score    = rsState.totalScore;
    const breakdown = rsState.scoreBreakdown;

    await saveScoreToFirestore(user, score, breakdown);

    ['score','otp'].forEach(m => {
      const el = document.getElementById('rs-modal-' + m + '-' + sid);
      if (el) el.classList.remove('open');
    });

    window.rsSetStep && window.rsSetStep(sid, 4);

    if (email) {
      await sendScoreEmail(email, name, score, breakdown);
      const doneEmail = document.getElementById('rs-done-email-' + sid);
      if (doneEmail) doneEmail.textContent = email;
    }

    document.getElementById('rs-modal-done-' + sid).classList.add('open');
  }

  window.rsGoogleLogin = async function(sid) {
    try {
      const result = await signInWithPopup(firebaseAuth, googleProvider);
      await rsAuthSuccess(sid, result.user);
    } catch(e) {
      showError('rs-signup-error-' + sid, '❌ Google login failed: ' + e.message);
    }
  };

  function setupRecaptcha(containerId) {
    if (window.rsRecaptchaVerifier) {
      try { window.rsRecaptchaVerifier.clear(); window.rsRecaptchaVerifier = null; } catch(e) {}
    }
    window.rsRecaptchaVerifier = new RecaptchaVerifier(firebaseAuth, containerId, {
      size: 'invisible', callback: () => {}
    });
    return window.rsRecaptchaVerifier;
  }

  window.rsSendOtp = async function(sid, mode) {
    const isSignup   = mode === 'signup';
    const phoneInput = document.getElementById(isSignup ? 'rs-phone-' + sid : 'rs-login-phone-' + sid);
    const emailInput = document.getElementById(isSignup ? 'rs-email-signup-' + sid : 'rs-login-email-' + sid);
    const phoneCode  = document.getElementById(isSignup ? 'rs-phone-code-' + sid : 'rs-login-phone-code-' + sid);
    const errorId    = (isSignup ? 'rs-signup-error-' : 'rs-login-error-') + sid;
    const btnId      = (isSignup ? 'rs-signup-submit-' : 'rs-login-submit-') + sid;
    const phone = phoneInput ? phoneInput.value.trim() : '';
    const email = emailInput ? emailInput.value.trim() : '';
    const code  = phoneCode  ? phoneCode.value.trim() : '+91';
    if (isSignup) rsState.userName = (document.getElementById('rs-name-' + sid) || {}).value || '';
    if (!phone && !email) { showError(errorId, 'Please enter phone or email.'); return; }
    setBtnLoading(btnId, true, 'Send OTP');
    try {
      if (phone) {
        const fullPhone = code + phone.replace(/^0+/, '');
        const rcId = isSignup ? 'rs-recaptcha-container-' + sid : 'rs-recaptcha-container2-' + sid;
        const appVerifier = setupRecaptcha(rcId);
        const confirmationResult = await signInWithPhoneNumber(firebaseAuth, fullPhone, appVerifier);
        rsState.confirmationResult = confirmationResult;
        rsState.otpMode = 'phone'; rsState.otpTarget = fullPhone;
        document.getElementById('rs-modal-score-' + sid).classList.remove('open');
        document.getElementById('rs-modal-otp-' + sid).classList.add('open');
        const sub = document.getElementById('rs-otp-subtitle-' + sid);
        if (sub) sub.textContent = 'Enter the 6-digit OTP sent to ' + fullPhone;
        startOtpTimer(sid);
      } else {
        await sendSignInLinkToEmail(firebaseAuth, email, { url: window.location.href, handleCodeInApp: true });
        window.localStorage.setItem('rsEmailForSignIn', email);
        rsState.otpMode = 'emaillink'; rsState.otpTarget = email;
        document.getElementById('rs-modal-score-' + sid).classList.remove('open');
        alert('✅ A sign-in link has been sent to ' + email + '. Check your inbox!');
      }
    } catch(e) {
      showError(errorId, '❌ ' + (e.message || 'Something went wrong.'));
    } finally { setBtnLoading(btnId, false, 'Send OTP'); }
  };

  window.rsVerifyOtp = async function(sid) {
    const inputs = document.querySelectorAll('#rs-modal-otp-' + sid + ' .rs-otp-input');
    const otp = Array.from(inputs).map(i => i.value).join('');
    if (otp.length < 6) { showError('rs-otp-error-' + sid, 'Please enter complete 6-digit OTP.'); return; }
    setBtnLoading('rs-otp-submit-' + sid, true, 'Verify & Get Score');
    try {
      if (rsState.otpMode === 'phone' && rsState.confirmationResult) {
        const result = await rsState.confirmationResult.confirm(otp);
        await rsAuthSuccess(sid, result.user);
      }
    } catch(e) {
      showError('rs-otp-error-' + sid, '❌ Invalid OTP. Try again.');
    } finally { setBtnLoading('rs-otp-submit-' + sid, false, 'Verify & Get Score'); }
  };

  window.rsResendOtp = async function(sid) {
    if (rsState.otpMode === 'phone' && rsState.otpTarget) {
      try {
        const appVerifier = setupRecaptcha('rs-recaptcha-container-' + sid);
        rsState.confirmationResult = await signInWithPhoneNumber(firebaseAuth, rsState.otpTarget, appVerifier);
        document.querySelectorAll('#rs-modal-otp-' + sid + ' .rs-otp-input').forEach(i => i.value = '');
        startOtpTimer(sid);
      } catch(e) { showError('rs-otp-error-' + sid, '❌ Failed to resend.'); }
    }
  };

  if (isSignInWithEmailLink(firebaseAuth, window.location.href)) {
    let email = window.localStorage.getItem('rsEmailForSignIn');
    if (!email) email = window.prompt('Please confirm your email:');
    const sids = Array.from(document.querySelectorAll('[id^="rs-calc-"]')).map(el => el.id.replace('rs-calc-',''));
    if (sids.length) {
      try {
        const result = await signInWithEmailLink(firebaseAuth, email, window.location.href);
        window.localStorage.removeItem('rsEmailForSignIn');
        await rsAuthSuccess(sids[0], result.user);
      } catch(e) { console.error('Email link error:', e); }
    }
  }

  window.__rsFirebaseAuth = firebaseAuth;

  document.addEventListener('rs-autosave', async function(e) {
    const user = e.detail.user || firebaseAuth.currentUser;
    if (!user) return;
    const sids = Array.from(document.querySelectorAll('[id^="rs-calc-"]')).map(el => el.id.replace('rs-calc-',''));
    const sid  = sids[0] || '{{ section.id }}';
    await rsAuthSuccess(sid, user);
  });

  document.addEventListener('rs-score-ready', function(e) {
    rsState.totalScore    = e.detail.total;
    rsState.scoreBreakdown = e.detail.breakdown;
  });
</script>

<!-- Non-module script -->
<script>
(function() {
  var sid = '{{ section.id }}';

  window.rsCheckAgree = function(id) {
    var cb = document.getElementById('rs-agree-' + id);
    var btn = document.getElementById('rs-take-test-' + id);
    if (!cb || !btn) return;
    btn.disabled = !cb.checked;
    btn.style.background = cb.checked ? '#2d2119' : '#aaa';
    btn.style.cursor = cb.checked ? 'pointer' : 'not-allowed';
  };

  window.rsGoStep2 = function(id) {
    document.getElementById('rs-step1-' + id).style.display = 'none';
    document.getElementById('rs-step2a-' + id).style.display = 'block';
    rsSetStep(id, 2);
    window.scrollTo({ top: document.getElementById('rs-calc-' + id).offsetTop - 80, behavior: 'smooth' });
  };

  // Step 2a → 2b: validate first 6 questions answered
  window.rsGoStep2b = function(id) {
    var groupsA = document.getElementById('rs-step2a-' + id).querySelectorAll('.rs-q-item__options');
    var allAnswered = true;
    groupsA.forEach(function(g) {
      if (!g.querySelector('.rs-q-btn.selected')) allAnswered = false;
    });
    if (!allAnswered) { alert('Please answer all 6 questions before proceeding.'); return; }
    document.getElementById('rs-step2a-' + id).style.display = 'none';
    document.getElementById('rs-step2b-' + id).style.display = 'block';
    window.scrollTo({ top: document.getElementById('rs-calc-' + id).offsetTop - 80, behavior: 'smooth' });
  };

  window.rsSetStep = function(id, step) {
    document.querySelectorAll('#rs-calc-' + id + ' .rs-step').forEach(function(s, i) {
      s.classList.remove('active','done');
      if (i + 1 < step) s.classList.add('done');
      if (i + 1 === step) s.classList.add('active');
    });
    for (var l = 1; l <= 3; l++) {
      var line = document.getElementById('rs-line' + l + '-' + id);
      if (line) line.classList.toggle('done', l < step);
    }
  };

  window.rsSelect = function(btn, id) {
    btn.closest('.rs-q-item__options').querySelectorAll('.rs-q-btn').forEach(function(b){ b.classList.remove('selected'); });
    btn.classList.add('selected');
  };

  // Score map: Never=0, Rarely=1, Sometimes=2, Often=3, Daily=4
  // Raw per question = value * 1 (no ×5), max per question = 4
  // Total raw max = 13 × 4 = 52
  // Final score = Math.round(rawTotal / 52 * 100), max = 100
  var RS_SCORE_MAP = { 'Never': 0, 'Rarely': 1, 'Sometimes': 2, 'Often': 3, 'Daily': 4 };

  var RS_CATEGORIES = [
    { label: 'Fruits & Vegetables',    qs: [0],      maxRaw: 4 },
    { label: 'Legumes',                qs: [1],      maxRaw: 4 },
    { label: 'Hydration',              qs: [2],      maxRaw: 4 },
    { label: 'Physical Activity',      qs: [3],      maxRaw: 4 },
    { label: 'Sleep Quality',          qs: [4],      maxRaw: 4 },
    { label: 'Energy Levels',          qs: [5],      maxRaw: 4 },
    { label: 'Family & Social',        qs: [6, 7],   maxRaw: 8 },
    { label: 'Focus & Productivity',   qs: [8, 9],   maxRaw: 8 },
    { label: 'Lifestyle Habits',       qs: [10, 11], maxRaw: 8 },
    { label: 'Stress & Mental Health', qs: [12],     maxRaw: 4 }
  ];

  window.rsSubmitQuiz = function(id) {
    // Collect from both step 2a and 2b
    var allGroups = [];
    document.getElementById('rs-step2a-' + id).querySelectorAll('.rs-q-item__options').forEach(function(g){ allGroups.push(g); });
    document.getElementById('rs-step2b-' + id).querySelectorAll('.rs-q-item__options').forEach(function(g){ allGroups.push(g); });

    var rawScores = [];
    var allAnswered = true;
    allGroups.forEach(function(g) {
      var sel = g.querySelector('.rs-q-btn.selected');
      if (sel) rawScores.push(RS_SCORE_MAP[sel.textContent.trim()] || 0);
      else allAnswered = false;
    });

    if (!allAnswered) { alert('Please answer all 7 remaining questions.'); return; }

    var rawTotal = rawScores.reduce(function(a, b){ return a + b; }, 0);
    // Scale to 100: max rawTotal = 13 * 4 = 52
    var finalScore = Math.round(rawTotal / 52 * 100);

    var breakdown = RS_CATEGORIES.map(function(cat) {
      var catRaw = cat.qs.reduce(function(s, qi){ return s + (rawScores[qi] || 0); }, 0);
      // Scale each category score to percentage of its own max, then to 100-scale proportion
      var catScore = Math.round(catRaw / cat.maxRaw * 100);
      return { category: cat.label, score: catScore, max: 100 };
    });

    document.dispatchEvent(new CustomEvent('rs-score-ready', { detail: { total: finalScore, breakdown: breakdown } }));
    rsSetStep(id, 3);
    document.getElementById('rs-score-display-' + id).textContent = finalScore;

    var currentUser = window.__rsFirebaseAuth ? window.__rsFirebaseAuth.currentUser : null;
    if (currentUser) {
      document.body.style.overflow = '';
      rsSetStep(id, 4);
      document.dispatchEvent(new CustomEvent('rs-autosave', { detail: { user: currentUser } }));
      return;
    }

    document.getElementById('rs-modal-score-' + id).classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  window.rsSwitchTab = function(id, tab) {
    var isSignup = tab === 'signup';
    document.getElementById('rs-tab-signup-' + id).classList.toggle('active', isSignup);
    document.getElementById('rs-tab-login-' + id).classList.toggle('active', !isSignup);
    document.getElementById('rs-signup-panel-' + id).style.display = isSignup ? '' : 'none';
    document.getElementById('rs-login-panel-' + id).style.display  = isSignup ? 'none' : '';
  };

  window.rsCheckSignupForm = function(id) {
    var phone = document.getElementById('rs-phone-' + id);
    var email = document.getElementById('rs-email-signup-' + id);
    var btn   = document.getElementById('rs-signup-submit-' + id);
    var ok = (phone && phone.value.trim().length >= 8) || (email && email.value.includes('@'));
    if (btn) btn.classList.toggle('active', ok);
  };

  window.rsCheckLoginForm = function(id) {
    var phone = document.getElementById('rs-login-phone-' + id);
    var email = document.getElementById('rs-login-email-' + id);
    var btn   = document.getElementById('rs-login-submit-' + id);
    var ok = (phone && phone.value.trim().length >= 8) || (email && email.value.includes('@'));
    if (btn) btn.classList.toggle('active', ok);
  };

  window.rsOtpNext = function(inp, id) {
    inp.value = inp.value.replace(/[^0-9]/g,'');
    var inputs = Array.from(document.querySelectorAll('#rs-modal-otp-' + id + ' .rs-otp-input'));
    var idx = inputs.indexOf(inp);
    if (inp.value && idx < inputs.length - 1) inputs[idx+1].focus();
    var filled = inputs.every(function(i){ return i.value !== ''; });
    var btn = document.getElementById('rs-otp-submit-' + id);
    if (btn) btn.classList.toggle('active', filled);
  };

  window.rsOtpBack = function(e, inp, id) {
    if (e.key === 'Backspace' && !inp.value) {
      var inputs = Array.from(document.querySelectorAll('#rs-modal-otp-' + id + ' .rs-otp-input'));
      var idx = inputs.indexOf(inp);
      if (idx > 0) inputs[idx-1].focus();
    }
  };

  window.rsCloseAll = function(id) {
    ['score','otp','done'].forEach(function(m){
      var el = document.getElementById('rs-modal-' + m + '-' + id);
      if (el) el.classList.remove('open');
    });
    document.body.style.overflow = '';
  };

  window.rsCalcReset = function(id) {
    rsCloseAll(id);
    document.getElementById('rs-step1-' + id).style.display = 'block';
    document.getElementById('rs-step2a-' + id).style.display = 'none';
    document.getElementById('rs-step2b-' + id).style.display = 'none';
    rsSetStep(id, 1);
    document.querySelectorAll('#rs-step2a-' + id + ' .rs-q-btn').forEach(function(b){ b.classList.remove('selected'); });
    document.querySelectorAll('#rs-step2b-' + id + ' .rs-q-btn').forEach(function(b){ b.classList.remove('selected'); });
    var cb = document.getElementById('rs-agree-' + id);
    if (cb) { cb.checked = false; rsCheckAgree(id); }
  };

  document.querySelectorAll('.rs-modal-overlay').forEach(function(ov){
    ov.addEventListener('click', function(e){ if (e.target === ov) rsCloseAll(sid); });
  });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') rsCloseAll(sid); });
})();
</script>

