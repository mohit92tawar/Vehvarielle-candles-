
<div class="wishlist-page">
  <h1 class="wishlist-page__title">My Wishlist</h1>
  <div class="wishlist-page__grid" id="rs-wishlist-grid">
    <div class="wishlist-page__loading">Loading...</div>
  </div>
</div>

<script>
(function() {
  const grid = document.getElementById('rs-wishlist-grid');
  const wishlist = JSON.parse(localStorage.getItem('rs_wishlist') || '[]');

  if (wishlist.length === 0) {
    grid.innerHTML = `
      <div class="wishlist-page__empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="56" height="56">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <p>Your wishlist is  empty </p>
        <a href="/collections">Start Shopping</a>
      </div>`;
    return;
  }

  // Fetch all wishlisted products
  Promise.all(
    wishlist.map(handle =>
      fetch(`/products/${handle}.js`).then(r => r.json()).catch(() => null)
    )
  ).then(products => {
    const valid = products.filter(Boolean);
    if (valid.length === 0) {
      grid.innerHTML = '<div class="wishlist-page__empty"><p>Koi product nahi mila.</p></div>';
      return;
    }

    grid.innerHTML = valid.map(p => {
      const img = p.featured_image ? p.featured_image : '';
      const price = '₹' + (p.price / 100).toLocaleString('en-IN');
      const comparePrice = p.compare_at_price > p.price
        ? '<span class="wishlist-card__compare">₹' + (p.compare_at_price / 100).toLocaleString('en-IN') + '</span>'
        : '';
      return `
        <div class="wishlist-card" data-handle="${p.handle}">
          <a href="/products/${p.handle}" class="wishlist-card__img-wrap">
            ${img ? `<img src="${img}" alt="${p.title}" loading="lazy">` : ''}
          </a>
          <div class="wishlist-card__info">
            <a href="/products/${p.handle}" class="wishlist-card__title">${p.title}</a>
            <div class="wishlist-card__price">
              <span class="wishlist-card__current">${price}</span>
              ${comparePrice}
            </div>
            <div class="wishlist-card__actions">
              <button class="wishlist-card__add-cart" data-id="${p.variants[0].id}">Add to Cart</button>
              <button class="wishlist-card__remove" data-handle="${p.handle}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                  <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
                </svg>
                Remove
              </button>
            </div>
          </div>
        </div>`;
    }).join('');

    // Add to cart
    grid.querySelectorAll('.wishlist-card__add-cart').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        btn.textContent = 'Adding...';
        btn.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, quantity: 1 })
        }).then(() => {
          btn.textContent = 'Added ✓';
          document.dispatchEvent(new CustomEvent('cart:updated'));
          setTimeout(() => { btn.textContent = 'Add to Cart'; btn.disabled = false; }, 2000);
        }).catch(() => { btn.textContent = 'Error'; btn.disabled = false; });
      });
    });

    // Remove from wishlist
    grid.querySelectorAll('.wishlist-card__remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const handle = btn.dataset.handle;
        let wl = JSON.parse(localStorage.getItem('rs_wishlist') || '[]');
        wl = wl.filter(h => h !== handle);
        localStorage.setItem('rs_wishlist', JSON.stringify(wl));
        window.dispatchEvent(new Event('wishlist:updated'));
        btn.closest('.wishlist-card').remove();
        if (grid.querySelectorAll('.wishlist-card').length === 0) {
          grid.innerHTML = '<div class="wishlist-page__empty"><p>Your whishlist is empty!</p><a href="/collections">Start Shoping </a></div>';
        }
      });
    });
  });
})();
</script>

<style>
.wishlist-page { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
.wishlist-page__title { font-size: 1.8rem; font-weight: 700; color: #4a2a15; margin-bottom: 32px; }
.wishlist-page__loading { color: #888; text-align: center; padding: 40px; }
.wishlist-page__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 24px;
}
.wishlist-page__empty {
  grid-column: 1/-1; display: flex; flex-direction: column;
  align-items: center; gap: 16px; padding: 60px 20px; text-align: center;
}
.wishlist-page__empty svg { color: #ccc; }
.wishlist-page__empty p { color: #888; font-size: 1rem; }
.wishlist-page__empty a {
  background: #4a2a15; color: #fff; text-decoration: none;
  padding: 12px 24px; border-radius: 8px; font-weight: 600;
}
.wishlist-card {
  border: 1px solid #eee; overflow: hidden;
  transition: box-shadow 0.2s;
}
.wishlist-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
.wishlist-card__img-wrap { display: block; aspect-ratio: 1; overflow: hidden; background: #f5f5f5; }
.wishlist-card__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.wishlist-card__img-wrap:hover img { transform: scale(1.04); }
.wishlist-card__info { padding: 14px; }
.wishlist-card__title {
  display: block; font-size: 0.9rem; font-weight: 600; color: #1a1a1a;
  text-decoration: none; margin-bottom: 6px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.wishlist-card__title:hover { color: #4a2a15; }
.wishlist-card__price { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
.wishlist-card__current { font-size: 0.95rem; font-weight: 700; color: #4a2a15; }
.wishlist-card__compare { font-size: 0.8rem; color: #aaa; text-decoration: line-through; }
.wishlist-card__actions { display: flex; gap: 8px; }
.wishlist-card__add-cart {
 flex: 1;
    background: transparent;
    color: #4a2a15;
    border: 1px solid #4a2a15;
    padding: 9px 12px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}
.wishlist-card__add-cart:hover { background: #4a2a15; color: #fff; }
.wishlist-card__add-cart:disabled { opacity: 0.6; cursor: not-allowed; }
.wishlist-card__remove {
 background: none;
    border: 1px solid #4a2a15;
    padding: 10px 10px;
    cursor: pointer;
    color: #4a2a15;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    transition: color 0.2s, border-color 0.2s;
}
.wishlist-card__remove:hover { color: #e53e3e; border-color: #e53e3e; }
</style>