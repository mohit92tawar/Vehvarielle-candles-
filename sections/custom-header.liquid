<div class="rs-search-overlay" id="rs-search-overlay" role="dialog" aria-modal="true">
  <div class="rs-search-box">
    <div class="search_header">
      <p class="rs-search-box__title">Search</p>
      <button class="rs-search-box__close" id="rs-search-close">✕</button>
    </div>
    <form class="rs-search-box__form" action="{{ routes.search_url }}" method="get" id="rs-search-form">
