{% comment %}
  Right Shift — Cart Page Section
  File: sections/rs-cart-page.liquid
  Features: Styled product cards, qty controls, remove, save for later, order summary
{% endcomment %}

<style>
/* ── RESET ── */
.rs-cart *, .rs-cart *::before, .rs-cart *::after {
  box-sizing: border-box; margin: 0; padding: 0;
}

/* ── ROOT ── */
.rs-cart {
  --brown:   #3b2a1e;
  --brown-light: #4A2A15;
  --green:   #1a5c2a;
  --border:  #e5e0d8;
  --cream:   #faf8f5;
  --muted:   #888;
  --text:    #1a1a1a;
  --subtext: #555;

  font-family: inherit;
  color: var(--text);
  background: #fff;
  padding: 40px 48px 80px;
  max-width: 1100px;
  margin: 0 auto;
}

/* ── HEADER ── */
.rs-cart__header {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 32px;
}
.rs-cart__title {
  font-size: 36px;
  font-weight: 500;
  color: var(--text);
}
.rs-cart__count {
  font-size: 13px;
  color: var(--subtext);
  background: #f2ede7;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 2px 12px;
}

/* ── GRID ── */
.rs-cart__grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 40px;
  align-items: start;
}

/* ── ITEMS ── */
.rs-cart__items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ── CARD ── */
.rs-cart-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
  display: flex;
  gap: 18px;
  align-items: flex-start;
  transition: border-color .2s, box-shadow .2s;
}
.rs-cart-card:hover {
  border-color: #c8bfb4;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
}

/* image */
.rs-cart-card__img {
  width: 100px;
  height: 100px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--cream);
  border: 1px solid var(--border);
}
.rs-cart-card__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}

/* body */
.rs-cart-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.rs-cart-card__brand {
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
}
.rs-cart-card__name {
  font-size: 16px;
  font-weight: 500;
  color: var(--text);
  text-decoration: none;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rs-cart-card__name:hover { color: var(--green); }
.rs-cart-card__variant {
  font-size: 12px;
  color: var(--muted);
}
.rs-cart-card__badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 2px 10px;
  border-radius: 20px;
  background: #f0ebe4;
  color: var(--brown-light);
  width: fit-content;
  margin-top: 2px;
}

/* footer row */
.rs-cart-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  flex-wrap: wrap;
  gap: 10px;
}
.rs-cart-card__price {
  font-size: 17px;
  font-weight: 500;
  color: var(--brown-light);
}
.rs-cart-card__compare {
  font-size: 13px;
  color: var(--muted);
  text-decoration: line-through;
  margin-right: 6px;
  font-weight: 400;
}

/* qty */
.rs-qty {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}
.rs-qty__btn {
  width: 34px; height: 34px;
  background: #faf8f5;
  border: none; cursor: pointer;
  font-size: 18px; color: var(--text);
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.rs-qty__btn:hover { background: #f0ebe4; }
.rs-qty__btn:disabled { opacity: .35; cursor: not-allowed; }
.rs-qty__val {
  width: 38px;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  border-left: 1px solid var(--border);
  border-right: 1px solid var(--border);
  line-height: 34px;
  user-select: none;
}

/* links row */
.rs-cart-card__links {
  display: flex;
  gap: 16px;
  margin-top: 10px;
}
.rs-cart-card__link {
  background: none;
  border: none;
  font-size: 12px;
  color: var(--muted);
  cursor: pointer;
  text-decoration: underline;
  padding: 0;
  transition: color .15s;
  font-family: inherit;
}
.rs-cart-card__link:hover { color: var(--text); }
.rs-cart-card__link--remove:hover { color: #c0392b; }

/* ── EMPTY ── */
.rs-cart__empty {
  text-align: center;
  padding: 80px 24px;
  border: 1px dashed var(--border);
  border-radius: 12px;
  color: var(--muted);
}
.rs-cart__empty p { font-size: 15px; margin-bottom: 20px; }
.rs-cart__empty a {
  display: inline-block;
  background: var(--brown);
  color: #fff;
  text-decoration: none;
  padding: 12px 28px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
  transition: background .2s;
}
.rs-cart__empty a:hover { background: #2a1d12; }

/* ── SUMMARY ── */
.rs-cart__summary {
  background: var(--cream);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px;
  position: sticky;
  top: 24px;
}
.rs-cart__summary-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}
.rs-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 14px;
  padding: 7px 0;
  color: var(--subtext);
}
.rs-summary-row span:last-child { font-weight: 500; color: var(--text); }
.rs-summary-row--free span:last-child { color: var(--green); }
.rs-summary-row--discount span:last-child { color: var(--green); }
.rs-summary-row--total {
  font-size: 17px;
  font-weight: 500;
  color: var(--text) !important;
  border-top: 1px solid var(--border);
  margin-top: 10px;
  padding-top: 14px;
}
.rs-summary-row--total span { font-weight: 500; color: var(--text) !important; }

/* note */
.rs-cart__summary-note {
  font-size: 11px;
  color: var(--muted);
  text-align: center;
  margin: 10px 0 16px;
}

/* checkout btn */
.rs-btn-checkout {
  display: block;
  width: 100%;
  padding: 15px;
  background: var(--brown);
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  transition: background .2s, transform .1s;
}
.rs-btn-checkout:hover { background: #2a1d12; }
.rs-btn-checkout:active { transform: scale(.98); }

/* continue btn */
.rs-btn-continue {
  display: block;
  width: 100%;
  padding: 12px;
  margin-top: 10px;
  background: none;
  color: var(--subtext);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  transition: background .15s, color .15s, border-color .15s;
  font-family: inherit;
}
.rs-btn-continue:hover {
  background: #fff;
  color: var(--text);
  border-color: #c8bfb4;
}

/* promo */
.rs-promo {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}
.rs-promo__label {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 8px;
  display: block;
}
.rs-promo__row {
  display: flex;
  gap: 8px;
}
.rs-promo__input {
  flex: 1;
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  outline: none;
  background: #fff;
  color: var(--text);
  font-family: inherit;
}
.rs-promo__input:focus { border-color: var(--brown); }
.rs-promo__btn {
  padding: 9px 16px;
  background: var(--brown);
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: background .2s;
  font-family: inherit;
}
.rs-promo__btn:hover { background: #2a1d12; }
.rs-promo__msg { font-size: 12px; color: var(--green); margin-top: 6px; min-height: 16px; }

/* msg toast */
.rs-cart__msg {
  font-size: 13px;
  padding: 10px 14px;
  border-radius: 6px;
  margin-bottom: 14px;
  display: none;
}
.rs-cart__msg.show { display: block; }
.rs-cart__msg--success { background: #eaf3e3; color: var(--green); }
.rs-cart__msg--error   { background: #fdecea; color: #c0392b; }

/* loading overlay on card */
.rs-cart-card.loading { opacity: .5; pointer-events: none; }

/* ── RESPONSIVE ── */
@media (max-width: 860px) {
  .rs-cart { padding: 24px 20px 60px; }
  .rs-cart__grid { grid-template-columns: 1fr; }
  .rs-cart__summary { position: static; }
}
@media (max-width: 480px) {
  .rs-cart__title { font-size: 26px; }
  .rs-cart-card { flex-direction: column; }
  .rs-cart-card__img { width: 100%; height: 200px; }
  .rs-cart-card__footer { flex-direction: column; align-items: flex-start; }
}
</style>

<div class="rs-cart" id="rs-cart-page">

  <div class="rs-cart__header">
    <h1 class="rs-cart__title">Cart</h1>
    <span class="rs-cart__count" id="rs-cart-item-count">
      {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
    </span>
  </div>

  <div class="rs-cart__msg" id="rs-cart-msg"></div>

  {% if cart.item_count == 0 %}

    <div class="rs-cart__empty">
      <p>Your cart is empty.</p>
      <a href="/collections">Start Shopping</a>
    </div>

  {% else %}

    <div class="rs-cart__grid">

      <!-- ══ ITEMS ══ -->
      <div class="rs-cart__items" id="rs-cart-items">
        {% for item in cart.items %}
          <div class="rs-cart-card" id="rs-item-{{ item.key | replace: ':', '-' }}" data-key="{{ item.key }}">

            <!-- Image -->
            <a href="{{ item.url }}" class="rs-cart-card__img">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title }}" loading="lazy">
              {% endif %}
            </a>

            <!-- Body -->
            <div class="rs-cart-card__body">
              <span class="rs-cart-card__brand">{{ item.vendor }}</span>
              <a href="{{ item.url }}" class="rs-cart-card__name" title="{{ item.product.title }}">
                {{ item.product.title }}
              </a>

              {% unless item.variant.title == 'Default Title' %}
                <span class="rs-cart-card__variant">{{ item.variant.title }}</span>
              {% endunless %}

              {%- assign product_tags = item.product.tags -%}
              {% if product_tags contains 'bestseller' or product_tags contains 'Bestseller' %}
                <span class="rs-cart-card__badge">Bestseller</span>
              {% endif %}

              <!-- Footer: price + qty -->
              <div class="rs-cart-card__footer">
                <div class="rs-cart-card__price-wrap">
                  {% if item.variant.compare_at_price > item.variant.price %}
                    <span class="rs-cart-card__compare">{{ item.variant.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="rs-cart-card__price" id="rs-item-price-{{ item.key | replace: ':', '-' }}">
                    {{ item.final_line_price | money }}
                  </span>
                </div>

                <div class="rs-qty">
                  <button
                    class="rs-qty__btn"
                    onclick="rsCartUpdateItem('{{ item.key }}', {{ item.quantity | minus: 1 }}, this)"
                    aria-label="Decrease"
                    {% if item.quantity <= 1 %}disabled{% endif %}
                  >−</button>
                  <span class="rs-qty__val" id="rs-qty-{{ item.key | replace: ':', '-' }}">{{ item.quantity }}</span>
                  <button
                    class="rs-qty__btn"
                    onclick="rsCartUpdateItem('{{ item.key }}', {{ item.quantity | plus: 1 }}, this)"
                    aria-label="Increase"
                  >+</button>
                </div>
              </div>

              <!-- Links -->
              <div class="rs-cart-card__links">
                <button
                  class="rs-cart-card__link rs-cart-card__link--remove"
                  onclick="rsCartRemoveItem('{{ item.key }}', this)"
                >Remove</button>
                <button
                  class="rs-cart-card__link"
                  onclick="rsCartSaveLater({{ item.product_id }}, this)"
                >Save for later</button>
              </div>

            </div>
          </div>
        {% endfor %}
      </div>

      <!-- ══ SUMMARY ══ -->
      <aside class="rs-cart__summary">
        <div class="rs-cart__summary-title">Order Summary</div>

        <div class="rs-summary-row">
          <span>Subtotal</span>
          <span id="rs-subtotal">{{ cart.total_price | money }}</span>
        </div>

        <div class="rs-summary-row rs-summary-row--free">
          <span>Shipping</span>
          <span>
            {% if cart.total_price >= 49900 %}Free{% else %}Calculated at checkout{% endif %}
          </span>
        </div>

        {% if cart.total_discount > 0 %}
          <div class="rs-summary-row rs-summary-row--discount">
            <span>Discounts</span>
            <span>−{{ cart.total_discount | money }}</span>
          </div>
        {% endif %}

        <div class="rs-summary-row rs-summary-row--total">
          <span>Total</span>
          <span id="rs-total">{{ cart.total_price | money }}</span>
        </div>

        <p class="rs-cart__summary-note">Taxes included. Shipping calculated at checkout.</p>

        <a href="/checkout" class="rs-btn-checkout">Proceed to Checkout →</a>
        <a href="/collections" class="rs-btn-continue">Continue Shopping</a>

        <!-- Promo code -->
        <div class="rs-promo">
          <span class="rs-promo__label">Have a promo code?</span>
          <div class="rs-promo__row">
            <input
              type="text"
              class="rs-promo__input"
              id="rs-promo-input"
              placeholder="Enter code"
              autocomplete="off"
            >
            <button class="rs-promo__btn" onclick="rsApplyPromo()">Apply</button>
          </div>
          <p class="rs-promo__msg" id="rs-promo-msg"></p>
        </div>

      </aside>

    </div>

  {% endif %}

</div>

<script>
(function () {

  /* ── HELPERS ── */
  function showMsg(text, type) {
    var el = document.getElementById('rs-cart-msg');
    if (!el) return;
    el.textContent = text;
    el.className = 'rs-cart__msg show rs-cart__msg--' + (type || 'success');
    clearTimeout(el._t);
    el._t = setTimeout(function () { el.classList.remove('show'); }, 3500);
  }

  function setCardLoading(key, state) {
    var card = document.getElementById('rs-item-' + key.replace(':', '-'));
    if (card) card.classList.toggle('loading', state);
  }

  function reloadPage() { window.location.reload(); }

  /* ── UPDATE QTY ── */
  window.rsCartUpdateItem = function (key, newQty, btn) {
    if (newQty < 0) return;
    setCardLoading(key, true);

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: key, quantity: newQty })
    })
    .then(function (res) { return res.json(); })
    .then(function (cart) {
      if (newQty === 0) {
        // item removed — reload to re-render Liquid properly
        reloadPage();
        return;
      }
      setCardLoading(key, false);
      // update qty display
      var safeKey = key.replace(':', '-');
      var qtyEl = document.getElementById('rs-qty-' + safeKey);
      if (qtyEl) qtyEl.textContent = newQty;

      // update decrease btn disabled state
      var card = document.getElementById('rs-item-' + safeKey);
      if (card) {
        var decBtn = card.querySelector('.rs-qty__btn');
        if (decBtn) decBtn.disabled = (newQty <= 1);
        // update onclick values
        var btns = card.querySelectorAll('.rs-qty__btn');
        btns[0] && btns[0].setAttribute('onclick', "rsCartUpdateItem('" + key + "'," + (newQty - 1) + ",this)");
        btns[1] && btns[1].setAttribute('onclick', "rsCartUpdateItem('" + key + "'," + (newQty + 1) + ",this)");
      }

      // update subtotal / total
      var subtotalEl = document.getElementById('rs-subtotal');
      var totalEl    = document.getElementById('rs-total');
      var formatted  = formatMoney(cart.total_price);
      if (subtotalEl) subtotalEl.textContent = formatted;
      if (totalEl)    totalEl.textContent    = formatted;

      // update count badge
      updateCountBadge(cart.item_count);
      showMsg('Cart updated!', 'success');
    })
    .catch(function () {
      setCardLoading(key, false);
      showMsg('Could not update cart. Please try again.', 'error');
    });
  };

  /* ── REMOVE ── */
  window.rsCartRemoveItem = function (key) {
    rsCartUpdateItem(key, 0, null);
  };

  /* ── SAVE FOR LATER (localStorage wishlist) ── */
  window.rsCartSaveLater = function (productId, btn) {
    try {
      var wishlist = JSON.parse(localStorage.getItem('rs_wishlist') || '[]');
      if (wishlist.indexOf(productId) === -1) wishlist.push(productId);
      localStorage.setItem('rs_wishlist', JSON.stringify(wishlist));
    } catch (e) {}
    if (btn) {
      var orig = btn.textContent;
      btn.textContent = '♥ Saved!';
      btn.style.color = '#c0392b';
      setTimeout(function () { btn.textContent = orig; btn.style.color = ''; }, 2000);
    }
  };

  /* ── PROMO ── */
  window.rsApplyPromo = function () {
    var code = (document.getElementById('rs-promo-input') || {}).value || '';
    var msg  = document.getElementById('rs-promo-msg');
    if (!msg) return;
    if (!code.trim()) { msg.style.color = '#c0392b'; msg.textContent = 'Please enter a code.'; return; }
    msg.style.color = '#aaa'; msg.textContent = 'Checking...';
    // Shopify discount codes are applied at checkout; redirect with discount param
    setTimeout(function () {
      msg.style.color = '#1a5c2a';
      msg.textContent = 'Code applied! Discount will reflect at checkout.';
      var checkoutBtn = document.querySelector('.rs-btn-checkout');
      if (checkoutBtn) checkoutBtn.href = '/checkout?discount=' + encodeURIComponent(code.trim());
    }, 800);
  };
  document.getElementById('rs-promo-input') && document.getElementById('rs-promo-input').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') rsApplyPromo();
  });

  /* ── MONEY FORMAT ── */
  function formatMoney(cents) {
    return '\u20B9' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /* ── CART COUNT BADGE ── */
  function updateCountBadge(count) {
    document.querySelectorAll('[data-cart-count],[data-cart-item-count],.cart-count,.rs-header__cart-count,#rs-cart-count').forEach(function (el) {
      el.textContent = count;
      el.setAttribute('data-count', count);
      el.style.display = count === 0 ? 'none' : '';
    });
    // update inline count label
    var countEl = document.getElementById('rs-cart-item-count');
    if (countEl) countEl.textContent = count + (count === 1 ? ' item' : ' items');
  }

})();
</script>

{% schema %}
{
  "name": "RS - Cart Page",
  "settings": [],
  "presets": [
    { "name": "RS - Cart Page" }
  ]
}
{% endschema %}
