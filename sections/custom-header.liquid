<script type="module">
  import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getAuth, onAuthStateChanged }     from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
  import { getFirestore, doc, getDoc }       from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const FIREBASE_CONFIG = {
    apiKey: "AIzaSyA-kUPK37duIL2OAE1uojfauxPV7HryTg4",
    authDomain: "right-shift-health.firebaseapp.com",
    projectId: "right-shift-health",
    storageBucket: "right-shift-health.firebasestorage.app",
    messagingSenderId: "13670469414",
    appId: "1:13670469414:web:f0949b066b363de928fbe7"
  };

  const app  = getApps().length ? getApp() : initializeApp(FIREBASE_CONFIG);
  const auth = getAuth(app);
  const db   = getFirestore(app);

  const headerEl  = document.getElementById('rs-main-header');
  const avatarEl  = document.getElementById('rs-header-avatar');
  const initialEl = document.getElementById('rs-header-avatar-initial');

  onAuthStateChanged(auth, async (user) => {
    if (!user) { headerEl.classList.remove('rs-header--logged-in'); return; }
    headerEl.classList.add('rs-header--logged-in');
    const photoURL = user.photoURL || '';
    const name     = user.displayName || '';
    const email    = user.email || user.phoneNumber || '';
    const initial  = name ? name[0].toUpperCase() : email ? email[0].toUpperCase() : 'U';
    if (photoURL) { avatarEl.innerHTML = `<img src="${photoURL}" alt="Profile">`; }
    else { initialEl.textContent = initial; }
    try {
      const snap = await getDoc(doc(db, 'users', user.uid));
      if (snap.exists()) {
        const data = snap.data();
        if (data.photoURL) { avatarEl.innerHTML = `<img src="${data.photoURL}" alt="Profile">`; }
        else if (data.firstName) { initialEl.textContent = data.firstName[0].toUpperCase(); }
      }
    } catch(e) {}
  });
</script>

<script>
(function () {
  const $ = id => document.getElementById(id);

  const searchBtn    = $('rs-search-btn');
  const overlay      = $('rs-search-overlay');
  const closeBtn     = $('rs-search-close');
  const input        = $('rs-search-input');
  const resultsPanel = $('rs-search-results');
  let searchTimer = null;
  let lastQuery   = '';

  function openSearch() {
    overlay.classList.add('rs-open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input.focus(), 100);
  }
  function closeSearch() {
    overlay.classList.remove('rs-open');
    document.body.style.overflow = '';
    resultsPanel.classList.remove('rs-visible');
    resultsPanel.innerHTML = '';
    input.value = '';
    lastQuery = '';
  }

  searchBtn && searchBtn.addEventListener('click', openSearch);
  closeBtn  && closeBtn.addEventListener('click', closeSearch);
  overlay   && overlay.addEventListener('click', e => { if (e.target === overlay) closeSearch(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeSearch(); closeCartDrawer(); } });

  input && input.addEventListener('input', function () {
    const q = this.value.trim();
    if (q === lastQuery) return;
    lastQuery = q;
    clearTimeout(searchTimer);
    if (q.length < 2) { resultsPanel.classList.remove('rs-visible'); resultsPanel.innerHTML = ''; return; }
    resultsPanel.classList.add('rs-visible');
    resultsPanel.innerHTML = '<div class="rs-search-results__loading"><div class="rs-search-results__spinner"></div>Searching…</div>';
    searchTimer = setTimeout(() => doSearch(q), 350);
  });

  function doSearch(q) {
    fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product,article,page&resources[limit]=5&resources[options][fields]=title,body,product_type,tag')
      .then(r => r.json()).then(data => renderResults(data, q))
      .catch(() => { resultsPanel.innerHTML = '<div class="rs-search-results__empty">Something went wrong. Please try again.</div>'; });
  }

  function placeholderSVG() {
    return '<div class="rs-search-result-item__img-placeholder"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a5c2a" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
  }

  function buildItem(item, type) {
    let img = '', sub = '', badge = '';
    const url = item.url || '#';
    if (type === 'product') {
      const imgSrc = item.featured_image && item.featured_image.url ? item.featured_image.url : (item.image ? item.image : '');
      img = imgSrc ? '<img src="' + imgSrc + '" alt="' + escH(item.title) + '" loading="lazy">' : placeholderSVG();
      badge = '<span class="rs-search-result-item__badge rs-search-result-item__badge--product">Product</span>';
      sub = badge + (item.product_type ? '<span>' + escH(item.product_type) + '</span>' : '');
    } else if (type === 'article') {
      const imgSrc = item.image ? item.image.url || item.image : '';
      img = imgSrc ? '<img src="' + imgSrc + '" alt="' + escH(item.title) + '" loading="lazy">' : placeholderSVG();
      badge = '<span class="rs-search-result-item__badge rs-search-result-item__badge--article">Blog</span>';
      sub = badge + (item.published_at ? '<span>' + new Date(item.published_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) + '</span>' : '');
    } else {
      img = placeholderSVG();
      badge = '<span class="rs-search-result-item__badge rs-search-result-item__badge--page">Page</span>';
      sub = badge;
    }
    return '<a href="' + url + '" class="rs-search-result-item" role="option"><div class="rs-search-result-item__img">' + img + '</div><div class="rs-search-result-item__info"><span class="rs-search-result-item__title">' + escH(item.title) + '</span><div class="rs-search-result-item__sub">' + sub + '</div></div></a>';
  }

  function renderResults(data, q) {
    const resources = data.resources && data.resources.results ? data.resources.results : {};
    const products = resources.products || [], articles = resources.articles || [], pages = resources.pages || [];
    if (products.length + articles.length + pages.length === 0) {
      resultsPanel.innerHTML = '<div class="rs-search-results__empty">No results found for "<strong>' + escH(q) + '</strong>"</div><a href="/search?q=' + encodeURIComponent(q) + '&type=product,article,page" class="rs-search-results__view-all">Search everything →</a>';
      return;
    }
    let html = '';
    if (products.length) { html += '<div class="rs-search-results__section"><div class="rs-search-results__section-title">Products</div>'; products.forEach(p => { html += buildItem(p, 'product'); }); html += '</div>'; }
    if (articles.length) { if (products.length) html += '<div class="rs-search-results__divider"></div>'; html += '<div class="rs-search-results__section"><div class="rs-search-results__section-title">Blog Posts</div>'; articles.forEach(a => { html += buildItem(a, 'article'); }); html += '</div>'; }
    if (pages.length) { if (products.length || articles.length) html += '<div class="rs-search-results__divider"></div>'; html += '<div class="rs-search-results__section"><div class="rs-search-results__section-title">Pages</div>'; pages.forEach(p => { html += buildItem(p, 'page'); }); html += '</div>'; }
    html += '<a href="/search?q=' + encodeURIComponent(q) + '&type=product,article,page" class="rs-search-results__view-all">View all results for "' + escH(q) + '" →</a>';
    resultsPanel.innerHTML = html;
  }

  /* HAMBURGER */
  const hamburger = $('rs-hamburger');
  const mobileNav = $('rs-mobile-nav');
  if (hamburger && mobileNav) {
    hamburger.addEventListener('click', () => {
      const open = mobileNav.classList.toggle('rs-open');
      hamburger.classList.toggle('rs-open', open);
      hamburger.setAttribute('aria-expanded', open);
    });
    mobileNav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      mobileNav.classList.remove('rs-open'); hamburger.classList.remove('rs-open'); hamburger.setAttribute('aria-expanded', 'false');
    }));
  }

  /* CART BADGE */
  function rsUpdateCartCount(count) {
    const badge = $('rs-cart-count'), drawerCount = $('rs-drawer-count');
    if (!badge) return;
    const prev = parseInt(badge.getAttribute('data-count') || '0', 10);
    badge.setAttribute('data-count', count);
    badge.textContent = count > 99 ? '99+' : count;
    badge.style.display = count === 0 ? 'none' : 'flex';
    if (drawerCount) drawerCount.textContent = count > 99 ? '99+' : count;
    if (count > prev) { badge.classList.remove('rs-bump'); void badge.offsetWidth; badge.classList.add('rs-bump'); badge.addEventListener('animationend', () => badge.classList.remove('rs-bump'), { once: true }); }
  }

  /* CART DRAWER */
  const cartDrawer = $('rs-cart-drawer'), cartOverlay = $('rs-cart-overlay');
  const cartBody = $('rs-cart-body'), cartFooter = $('rs-cart-footer'), cartLoading = $('rs-cart-loading');
  let drawerOpen = false;

  function formatMoney(cents) { return '₹' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function openCartDrawer() {
    drawerOpen = true;
    cartOverlay.classList.add('rs-open'); cartDrawer.classList.add('rs-open');
    document.body.style.overflow = 'hidden'; cartOverlay.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => cartOverlay.classList.add('rs-visible'));
    loadCart();
  }
  function closeCartDrawer() {
    drawerOpen = false;
    cartOverlay.classList.remove('rs-visible'); cartDrawer.classList.remove('rs-open');
    document.body.style.overflow = ''; cartOverlay.setAttribute('aria-hidden', 'true');
    setTimeout(() => cartOverlay.classList.remove('rs-open'), 300);
  }

  $('rs-cart-open-btn') && $('rs-cart-open-btn').addEventListener('click', openCartDrawer);
  $('rs-cart-close-btn') && $('rs-cart-close-btn').addEventListener('click', closeCartDrawer);
  cartOverlay && cartOverlay.addEventListener('click', closeCartDrawer);

  function renderCart(cart) {
    rsUpdateCartCount(cart.item_count);
    if (cart.item_count === 0) {
      cartLoading.style.display = 'none'; cartFooter.style.display = 'none';
      cartBody.innerHTML = `<div class="rs-cart-drawer__empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><p>Your cart is empty</p><a href="/collections">Start Shopping</a></div>`;
      return;
    }
    let itemsHTML = '<div class="rs-cart-drawer__items">';
    cart.items.forEach(item => {
      const imgSrc = item.image ? item.image.replace(/(\.\w+)$/, '_120x120$1') : '';
      const variantTitle = item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '';
      itemsHTML += `<div class="rs-cart-item" data-key="${item.key}"><div class="rs-cart-item__img">${imgSrc ? `<img src="${imgSrc}" alt="${item.product_title}" loading="lazy">` : ''}</div><div class="rs-cart-item__info"><a href="${item.url}" class="rs-cart-item__title" title="${item.product_title}">${item.product_title}</a>${variantTitle ? `<span class="rs-cart-item__variant">${variantTitle}</span>` : ''}<span class="rs-cart-item__price">${formatMoney(item.final_line_price)}</span></div><div class="rs-cart-item__controls"><div class="rs-cart-item__qty"><button class="rs-cart-item__qty-btn" data-action="decrease" data-key="${item.key}" aria-label="Decrease quantity" ${item.quantity <= 1 ? 'disabled' : ''}>−</button><span class="rs-cart-item__qty-val">${item.quantity}</span><button class="rs-cart-item__qty-btn" data-action="increase" data-key="${item.key}" aria-label="Increase quantity">+</button></div><button class="rs-cart-item__remove" data-key="${item.key}" aria-label="Remove item"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>Remove</button></div></div>`;
    });
    itemsHTML += '</div>';
    cartLoading.style.display = 'none'; cartBody.innerHTML = itemsHTML; cartFooter.style.display = 'block';
    $('rs-cart-subtotal').textContent = formatMoney(cart.total_price);
    cartBody.querySelectorAll('.rs-cart-item__qty-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key, action = btn.dataset.action;
        const item = cartBody.querySelector(`.rs-cart-item[data-key="${key}"]`);
        const qty = parseInt(item.querySelector('.rs-cart-item__qty-val').textContent, 10);
        const newQty = action === 'increase' ? qty + 1 : qty - 1;
        if (newQty < 1) return;
        updateCartItem(key, newQty);
      });
    });
    cartBody.querySelectorAll('.rs-cart-item__remove').forEach(btn => { btn.addEventListener('click', () => updateCartItem(btn.dataset.key, 0)); });
  }

  function loadCart() {
    cartLoading && (cartLoading.style.display = 'flex');
    cartBody.innerHTML = ''; cartBody.appendChild(cartLoading);
    cartLoading.style.display = 'flex'; cartFooter.style.display = 'none';
    fetch('/cart.js').then(r => r.json()).then(data => renderCart(data))
      .catch(() => { cartLoading.style.display = 'none'; cartBody.innerHTML = '<div class="rs-cart-drawer__empty"><p>Could not load cart. Please refresh.</p></div>'; });
  }

  function updateCartItem(key, quantity) {
    fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ id: key, quantity }) })
      .then(r => r.json()).then(data => renderCart(data)).catch(() => loadCart());
  }

  fetch('/cart.js').then(r => r.json()).then(d => rsUpdateCartCount(d.item_count || 0)).catch(() => {});

  document.addEventListener('cart:updated', e => {
    const count = e.detail?.itemCount ?? null;
    if (count !== null) rsUpdateCartCount(count);
    else fetch('/cart.js').then(r => r.json()).then(d => rsUpdateCartCount(d.item_count || 0)).catch(() => {});
    if (drawerOpen) loadCart();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') fetch('/cart.js').then(r => r.json()).then(d => rsUpdateCartCount(d.item_count || 0)).catch(() => {});
  });

  /* WISHLIST COUNT */
  function rsUpdateWishlistCount() {
    const wishlist = JSON.parse(localStorage.getItem('rs_wishlist') || '[]');
    const badge = document.getElementById('rs-wishlist-count');
    if (!badge) return;
    const count = wishlist.length;
    badge.textContent = count > 99 ? '99+' : count;
    badge.setAttribute('data-count', count);
    badge.style.display = count === 0 ? 'none' : 'flex';
  }
  rsUpdateWishlistCount();
  window.addEventListener('wishlist:updated', rsUpdateWishlistCount);

  function escH(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

})();
</script>

{% schema %}
{
  "name": "RS - Header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo Image (blank = shop name as text)" },
    { "type": "header", "content": "Navigation" },
    {
