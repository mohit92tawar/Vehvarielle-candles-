<style>

.rs-search-box input:not([type=checkbox],[type=radio]) { color: #2d1921; }
.rs-account-wrap:hover .rs-header__avatar-btn + .rs-account-dropdown,
.rs-account-wrap:hover .rs-account-btn + .rs-account-dropdown {
  display: block;
}
.rs-account-wrap {
  position: relative;
}
.rs-account-wrap::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  height: 14px;
  background: transparent;
}
.rs-account-dropdown {
  display: none;
  position: absolute;
  top: 40px;
  right: 0;
  width: 240px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.14);
  border: 1px solid #f0f0f0;
  z-index: 9999;
  overflow: hidden;
  animation: rsDropFade 0.18s ease;
}
@keyframes rsDropFade {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
.rs-account-wrap:hover .rs-account-dropdown,
.rs-account-wrap:focus-within .rs-account-dropdown {
  display: block;
}
.rs-account-dropdown__header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: #f6fbf7;
}
.rs-account-dropdown__avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: #1a5c2a; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; font-weight: 700; flex-shrink: 0;
}
.rs-account-dropdown__name { font-size: 0.88rem; font-weight: 700; color: #1a1a1a; }
.rs-account-dropdown__email {
  font-size: 0.72rem; color: #888;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;
}
.rs-account-dropdown__divider { height: 1px; background: #f0f0f0; margin: 4px 0; }
.rs-account-dropdown__link {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 16px;
  font-size: 0.88rem; font-weight: 500; color: #1a1a1a;
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}
.rs-account-dropdown__link:hover { background: #f6fbf7; color: #1a5c2a; }
.rs-account-dropdown__link--logout { color: #e53e3e; }
.rs-account-dropdown__link--logout:hover { background: #fff5f5; color: #c53030; }
.rs-account-dropdown__guest {
  padding: 20px 16px;
  display: flex; flex-direction: column; gap: 10px; text-align: center;
}
.rs-account-dropdown__guest p { font-size: 0.85rem; color: #555; margin-bottom: 4px; }
.rs-account-dropdown__signin {
  display: block; background: #4A2A15; color: #fff;
  text-decoration: none; padding: 10px; border-radius: 8px;
  font-weight: 600; font-size: 0.88rem; transition: background 0.2s;
}
.rs-account-dropdown__signin:hover { background: #4A2A15; }
.rs-account-dropdown__register {
  display: block; color: #4A2A15; text-decoration: none;
  font-size: 0.82rem; font-weight: 500; padding: 6px; transition: color 0.2s;
}
.rs-account-dropdown__register:hover { color: #4A2A15; }

@media (max-width: 768px) {
  .rs-account-dropdown { display: none !important; }
  .rs-account-wrap::after { display: none; }
}

.search_header { display: flex; align-items: center; justify-content: space-between; }

.scrolled .rs-header {
  background: #fff;
  border-bottom: 1px solid #e8e8e8;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  width: 100%;
  {% comment %} max-width: 1470px; {% endcomment %}
  margin: 0 auto;
}

{% comment %} body { padding-top: 92px; } {% endcomment %}
@media (max-width: 768px) { body { padding-top: 78px; } }

.rs-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 48px 6px;
  gap: 20px;
  height: 92px;
  background: #f8f9fa;
  position: relative;
}

/* LOGO — centered absolutely like véhvarielle reference */
.rs-header__logo {
  text-decoration: none;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.rs-header__logo-img { height: 48px; width: auto; object-fit: contain; }
.rs-header__logo-text {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400;
  font-size: 1.6rem;
  color: #1a1a1a;
  letter-spacing: 0.04em;
  line-height: 1;
  white-space: nowrap;
}

.rs-header__nav { display: flex; align-items: center; flex: 1; justify-content: center; }
.rs-header__nav-link {
  font-size: 16px; font-weight: 500; color: #1a1a1a;
  text-decoration: none; padding: 6px 11px; white-space: nowrap;
  position: relative; transition: color 0.2s;
}
.rs-header__nav-link:hover { color: #1a5c2a; }
.rs-header__nav-link.rs-active { color: #175c2f; }
.rs-header__nav-link.rs-active::after {
  content: ''; display: block; height: 2px; background: #175c2f;
  border-radius: 2px; position: absolute; bottom: 2px; left: 12px; right: 12px;
}

.rs-header__icons { display: flex; align-items: center; gap: 20px; flex-shrink: 0; }
.rs-header__icon-btn {
  background: none; border: none; cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 4px; color: #4A2A15; text-decoration: none; transition: color 0.2s;
}
.rs-header__icon-btn:hover { color: #4A2A15; }
.rs-header__icon-btn svg { width: 22px; height: 22px; }
.rs-header__icon-label { font-size: 0.65rem; color: #555; }

.rs-header__cart-btn {
  background: none; border: none; cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 4px; color: #4A2A15; text-decoration: none; transition: color 0.2s;
  position: relative;
}
.rs-header__cart-btn:hover { color: #4A2A15; }
.rs-header__cart-btn svg { width: 22px; height: 22px; }
.rs-header__cart-label { font-size: 0.65rem; color: #555; }

.rs-header__cart-count {
  position: absolute; top: -2px; right: -4px;
  background: #4A2A15; color: #fff;
  font-size: 0.6rem; font-weight: 700;
  min-width: 16px; height: 16px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  padding: 0 3px; line-height: 1; pointer-events: none;
  transition: transform 0.2s ease;
}
.rs-header__cart-count[data-count="0"] { display: none; }
.rs-header__cart-count.rs-bump { animation: rs-cart-bump 0.3s ease; }
@keyframes rs-cart-bump {
  0% { transform: scale(1); } 50% { transform: scale(1.4); } 100% { transform: scale(1); }
}

.rs-header__user-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: #1a5c2a; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem; font-weight: 700; border: 2px solid #1a5c2a;
  cursor: pointer; overflow: hidden; text-decoration: none;
  transition: box-shadow 0.2s; flex-shrink: 0;
}
.rs-header__user-avatar:hover { box-shadow: 0 0 0 3px rgba(26,92,42,0.25); }
.rs-header__user-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.rs-header__login-btn { display: flex; }
.rs-header__avatar-btn { display: none; }
.rs-header--logged-in .rs-header__login-btn { display: none; }
.rs-header--logged-in .rs-header__avatar-btn { display: flex; }

/* HAMBURGER */
.rs-header__hamburger {
  display: flex; flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer; padding: 4px;
  flex-shrink: 0; z-index: 1;
}
.rs-header__hamburger span {
  display: block; width: 24px; height: 2.5px;
  background: #4A2A15; border-radius: 2px; transition: all 0.3s;
}
.rs-header__hamburger.rs-open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
.rs-header__hamburger.rs-open span:nth-child(2) { opacity: 0; }
.rs-header__hamburger.rs-open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

.rs-mobile-nav { display: none; flex-direction: column; background: #4A2A15; padding: 8px 0 16px; margin: 20px; border-radius: 20px; }
.rs-mobile-nav.rs-open { display: flex; }
.rs-mobile-nav__link {
  font-size: 1rem; font-weight: 700; color: #FFF; text-decoration: none;
  padding: 10px 24px; transition: background 0.15s, color 0.15s;
}
.rs-mobile-nav__link:last-child { border-bottom: none; }
.rs-mobile-nav__link:hover, .rs-mobile-nav__link.rs-active { color: #FFF; font-weight: 700; }

/* SEARCH OVERLAY */
.rs-search-overlay {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 9999;
  align-items: flex-start; justify-content: center; padding-top: 60px;
}
.rs-search-overlay.rs-open { display: flex; }

.rs-search-box {
  position: relative;
  background: #fff; border-radius: 16px; padding: 24px;
  width: 90%; max-width: 620px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  display: flex; flex-direction: column; gap: 0;
  max-height: 85vh; overflow: hidden;
}
.rs-search-box__title { font-size: 1.1rem; font-weight: 700; color: #1a1a1a; margin-bottom: 14px; }
.rs-search-box__form { display: flex; gap: 10px; }
.rs-search-box__input {
  flex: 1; padding: 12px 16px; border: 2px solid #1a5c2a;
  border-radius: 8px; font-size: 1rem; outline: none; color: #1a1a1a;
}
.rs-search-box__input:focus { box-shadow: 0 0 0 3px rgba(26,92,42,0.15); }
.rs-search-box__submit {
  background: #4A2A15; color: #fff; border: none; border-radius: 8px;
  padding: 12px 20px; cursor: pointer; font-size: 1rem; font-weight: 600;
  display: flex; align-items: center; justify-content: center; transition: background 0.2s;
}
.rs-search-box__submit:hover { background: #4A2A15; }
.rs-search-box__close {
  background: none; border: none; color: #000;
  font-size: 30px; cursor: pointer; position: absolute; right: 6px; top: 6px;
}
.rs-search-box__close:hover { color: #1a1a1a; }

.rs-search-results {
  display: none; margin-top: 14px; border-top: 1px solid #f0f0f0;
  overflow-y: auto; max-height: calc(85vh - 130px);
}
.rs-search-results.rs-visible { display: block; }
.rs-search-results__loading {
  display: flex; align-items: center; justify-content: center;
  gap: 10px; padding: 28px 0; color: #888; font-size: 0.9rem;
}
.rs-search-results__spinner {
  width: 20px; height: 20px; border: 2.5px solid #e0e0e0;
  border-top-color: #1a5c2a; border-radius: 50%;
  animation: rs-spin 0.7s linear infinite; flex-shrink: 0;
}
@keyframes rs-spin { to { transform: rotate(360deg); } }
.rs-search-results__section { padding: 12px 4px 6px; }
.rs-search-results__section-title {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: #aaa; margin-bottom: 4px;
}
.rs-search-result-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 8px; border-radius: 10px;
  text-decoration: none; color: #1a1a1a; transition: background 0.15s;
}
.rs-search-result-item:hover { background: #f4faf6; }
.rs-search-result-item__img {
  width: 48px; height: 48px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
  background: #f0f0f0; border: 1px solid #eee;
  display: flex; align-items: center; justify-content: center;
}
.rs-search-result-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rs-search-result-item__img-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eaf3e3;
}
.rs-search-result-item__info { flex: 1; min-width: 0; }
.rs-search-result-item__title {
  font-size: 20px; font-weight: 600; color: #2d1921;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;
}
.rs-search-result-item__sub {
  font-size: 0.75rem; color: #888; margin-top: 2px;
  display: flex; align-items: center; gap: 6px;
}
.rs-search-result-item__badge {
  font-size: 0.65rem; font-weight: 700; letter-spacing: 0.05em;
  padding: 2px 6px; border-radius: 4px; text-transform: uppercase;
}
.rs-search-result-item__badge--product { background: #eaf3e3; color: #1a5c2a; }
.rs-search-result-item__badge--article { background: #e8f0fb; color: #1a4a8a; }
.rs-search-result-item__badge--page    { background: #fdf3e3; color: #8a5a1a; }
.rs-search-result-item__price { font-size: 0.85rem; font-weight: 700; color: #1a5c2a; flex-shrink: 0; }
.rs-search-results__view-all {
  display: block; text-align: center; padding: 14px 8px 4px;
  font-size: 0.85rem; font-weight: 600; color: #1a5c2a;
  text-decoration: none; border-top: 1px solid #f0f0f0; margin-top: 8px; transition: color 0.2s;
}
.rs-search-results__view-all:hover { color: #145022; text-decoration: underline; }
.rs-search-results__empty { text-align: center; padding: 28px 0; font-size: 0.9rem; color: #aaa; }
.rs-search-results__divider { height: 1px; background: #f5f5f5; margin: 8px 0; }

/* CART DRAWER */
.rs-cart-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.45); z-index: 10000;
  transition: opacity 0.3s ease; opacity: 0;
}
.rs-cart-overlay.rs-open { display: block; }
.rs-cart-overlay.rs-visible { opacity: 1; }
.rs-cart-drawer {
  position: fixed; top: 0; right: 0; bottom: 0;
  width: 420px; max-width: 100vw; background: #fff; z-index: 10001;
  display: flex; flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -4px 0 32px rgba(0,0,0,0.15);
}
.rs-cart-drawer.rs-open { transform: translateX(0); }
.rs-cart-drawer__header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 24px; border-bottom: 1px solid #e8e8e8; flex-shrink: 0;
}
.rs-cart-drawer__title {
  font-size: 1.1rem; font-weight: 700; color: #1a1a1a;
  display: flex; align-items: center; gap: 8px;
}
.rs-cart-drawer__title-count {
  background: #4A2A15; color: #fff; font-size: 0.7rem; font-weight: 700;
  min-width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; padding: 0 4px;
}
.rs-cart-drawer__close {
  background: none; border: none; cursor: pointer; color: #555;
  padding: 6px; border-radius: 6px; display: flex; align-items: center;
  transition: background 0.2s, color 0.2s;
}
.rs-cart-drawer__close:hover { background: #f2f2f2; color: #1a1a1a; }
.rs-cart-drawer__close svg { width: 20px; height: 20px; }
.rs-cart-drawer__body { flex: 1; overflow-y: auto; padding: 0; }
.rs-cart-drawer__body::-webkit-scrollbar { width: 4px; }
.rs-cart-drawer__body::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
.rs-cart-drawer__loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 48px 24px; gap: 16px; color: #888;
}
.rs-cart-drawer__spinner {
  width: 32px; height: 32px; border: 3px solid #e8e8e8;
  border-top-color: #1a5c2a; border-radius: 50%; animation: rs-spin 0.7s linear infinite;
}
.rs-cart-drawer__empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 56px 24px; gap: 16px; text-align: center;
}
.rs-cart-drawer__empty svg { width: 56px; height: 56px; color: #ccc; }
.rs-cart-drawer__empty p { color: #888; font-size: 0.95rem; }
.rs-cart-drawer__empty a {
  display: inline-block; margin-top: 8px; background: #4A2A15; color: #fff;
  text-decoration: none; padding: 12px 24px; border-radius: 8px;
  font-weight: 600; font-size: 0.9rem; transition: background 0.2s;
}
.rs-cart-drawer__empty a:hover { background: #492914; }
.rs-cart-drawer__items { padding: 8px 0; }
.rs-cart-item {
  display: flex; gap: 14px; padding: 16px 24px;
  border-bottom: 1px solid #f2f2f2; transition: background 0.15s;
}
.rs-cart-item:last-child { border-bottom: none; }
.rs-cart-item:hover { background: #fafafa; }
.rs-cart-item__img {
  width: 72px; height: 72px; border-radius: 8px; overflow: hidden;
  flex-shrink: 0; background: #f5f5f5; border: 1px solid #eee;
}
.rs-cart-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rs-cart-item__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.rs-cart-item__title {
  font-size: 0.88rem; font-weight: 600; color: #4A2A15;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none;
}
.rs-cart-item__title:hover { color: #1a5c2a; }
.rs-cart-item__variant { font-size: 0.75rem; color: #888; }
.rs-cart-item__price { font-size: 0.88rem; font-weight: 700; color: #4A2A15; margin-top: auto; }
.rs-cart-item__controls {
  display: flex; flex-direction: column; align-items: flex-end;
  justify-content: space-between; flex-shrink: 0;
}
.rs-cart-item__qty {
  display: flex; align-items: center; border: 1.5px solid #e0e0e0; border-radius: 6px; overflow: hidden;
}
.rs-cart-item__qty-btn {
  background: none; border: none; cursor: pointer;
  width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; color: #555; transition: background 0.15s, color 0.15s;
}
.rs-cart-item__qty-btn:hover { background: #f0f0f0; color: #1a1a1a; }
.rs-cart-item__qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.rs-cart-item__qty-val {
  width: 28px; text-align: center; font-size: 0.85rem;
  font-weight: 600; color: #1a1a1a; user-select: none;
}
.rs-cart-item__remove {
  background: none; border: none; cursor: pointer; color: #bbb;
  font-size: 0.72rem; padding: 2px; transition: color 0.2s;
  display: flex; align-items: center; gap: 3px;
}
.rs-cart-item__remove:hover { color: #e53e3e; }
.rs-cart-drawer__footer {
  border-top: 1px solid #e8e8e8; padding: 20px 24px; flex-shrink: 0; background: #fff;
}
.rs-cart-drawer__subtotal {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;
}
.rs-cart-drawer__subtotal-label { font-size: 0.88rem; color: #555; }
.rs-cart-drawer__subtotal-price { font-size: 1.05rem; font-weight: 700; color: #1a1a1a; }
.rs-cart-drawer__note { font-size: 0.72rem; color: #aaa; margin-bottom: 16px; text-align: center; }
.rs-cart-drawer__checkout {
  display: block; width: 100%; background: #4A2A15; color: #fff;
  text-decoration: none; text-align: center; padding: 14px; border-radius: 10px;
  font-size: 1rem; font-weight: 700; border: none; cursor: pointer;
  transition: background 0.2s, transform 0.1s;
}
.rs-cart-drawer__checkout:hover { background: #4A2A15; }
.rs-cart-drawer__checkout:active { transform: scale(0.98); }
.rs-cart-drawer__view-cart {
  display: block; width: 100%; text-align: center; margin-top: 10px;
  color: #555; font-size: 0.85rem; text-decoration: none; padding: 6px;
  border-radius: 6px; transition: color 0.2s, background 0.2s;
}
.rs-cart-drawer__view-cart:hover { color: #1a5c2a; background: #f6fbf7; }

/* RESPONSIVE */
@media (max-width: 1024px) {
  .rs-header__inner { padding: 12px 24px; }
  .rs-header__nav-link { font-size: 0.85rem; padding: 6px 8px; }
}
@media (max-width: 768px) {
  .rs-header__inner { height: 68px; padding: 12px 16px; }
  .rs-header { background: #fff7e3; }
  .rs-header__logo-img { height: 36px; }
  .rs-header__logo-text { font-size: 1.25rem; }
  .rs-header__nav { display: none; }
  .rs-header__icon-label { display: none; }
  .rs-header__cart-label { display: none; }
  .rs-header__icons { gap: 12px; }
  .rs-cart-drawer { width: 100vw; }
}

@media (max-width: 768px) {

  .rs-header__logo {
    position: static;   /* center hat jayega */
    transform: none;
  }

  .rs-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rs-header__hamburger {
    order: 2;   /* right side */
  }

  .rs-header__logo {
    order: 1;   /* left side */
  }

  .rs-header__icons {
    display: none; /* optional: agar mobile me icons hide karne ho */
  }
}
</style>

<header class="rs-header" role="banner" id="rs-main-header">
  <div class="rs-header__inner">

    <button class="rs-header__hamburger" id="rs-hamburger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="rs-header__logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="rs-header__logo-img">
      {% else %}
        <div class="rs-header__logo-text">{{ shop.name }}</div>
      {% endif %}
    </a>

    <div class="rs-header__icons">

      <button class="rs-header__icon-btn" id="rs-search-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <a href="/pages/wishlist" class="rs-header__icon-btn rs-wishlist-btn" aria-label="Wishlist" style="position:relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="rs-header__cart-count" id="rs-wishlist-count" data-count="0" style="display:none;">0</span>
      </a>

      <div class="rs-account-wrap">
        <a href="{{ routes.account_url }}"
           class="rs-header__icon-btn rs-account-btn rs-header__login-btn"
           aria-label="Account">
          {{ 'user.svg' | inline_asset_content}} 
        </a>

        <a href="/account"
           class="rs-header__user-avatar rs-header__avatar-btn"
           id="rs-header-avatar"
           aria-label="My Account"
           title="My Account">
          <span id="rs-header-avatar-initial">U</span>
