        <div class="rs-account-dropdown">
          {% if customer %}
            <div class="rs-account-dropdown__header">
              <div class="rs-account-dropdown__avatar">{{ customer.first_name | slice: 0 | upcase }}</div>
              <div>
                <div class="rs-account-dropdown__name">{{ customer.first_name }} {{ customer.last_name }}</div>
                <div class="rs-account-dropdown__email">{{ customer.email }}</div>
              </div>
            </div>
            <div class="rs-account-dropdown__divider"></div>
            <a href="{{ routes.account_url }}" class="rs-account-dropdown__link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              My Account
            </a>
            <a href="{{ routes.account_url }}" class="rs-account-dropdown__link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              My Orders
            </a>
            <a href="/pages/wishlist" class="rs-account-dropdown__link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              My Wishlist
            </a>
            <div class="rs-account-dropdown__divider"></div>
            <a href="{{ routes.account_logout_url }}" class="rs-account-dropdown__link rs-account-dropdown__link--logout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Logout
            </a>
          {% else %}
            <div class="rs-account-dropdown__guest">
              <p>Sign in to your account</p>
              <a href="{{ routes.account_login_url }}" class="rs-account-dropdown__signin">Sign In</a>
              <a href="{{ routes.account_register_url }}" class="rs-account-dropdown__register">Create Account</a>
            </div>
          {% endif %}
