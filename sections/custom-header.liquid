      </div>

      <button class="rs-header__cart-btn" id="rs-cart-open-btn" aria-label="Open cart" aria-haspopup="dialog">
      {{- 'icon-cart.svg' | inline_asset_content -}}
        <span class="rs-header__cart-count" id="rs-cart-count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </button>

    </div>
  </div>

  <nav class="rs-mobile-nav" id="rs-mobile-nav" aria-label="Mobile navigation">
    {% if section.settings.menu != blank %}
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="rs-mobile-nav__link{% if link.active %} rs-active{% endif %}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="/" class="rs-mobile-nav__link">Home</a>
      <a href="/pages/why-make-the-shift" class="rs-mobile-nav__link rs-active">Why Make The Shift</a>
      <a href="/pages/know-your-health" class="rs-mobile-nav__link">Know Your Health</a>
      <a href="/pages/free-meal-plan" class="rs-mobile-nav__link">Free Meal Plan</a>
      <a href="/pages/free-consultation" class="rs-mobile-nav__link">Free Consultation</a>
      <a href="/collections/shift-shop" class="rs-mobile-nav__link">Shift Shop</a>
      <a href="/blogs/right-talk" class="rs-mobile-nav__link">Right Talk</a>
    {% endif %}
  </nav>
</header>

