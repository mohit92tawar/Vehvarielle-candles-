<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
>
  <div class="announcement-bar__marquee-wrapper">
    <div class="announcement-bar__marquee" id="marquee-track" style="--marquee-speed: {{ section.settings.speed }}s;">
      <div class="marquee-set marquee-set--original">
        {% content_for 'blocks' %}
      </div>
      <div class="marquee-set marquee-set--clone" aria-hidden="true"></div>
    </div>
  </div>
</aside>

<script>
  (function () {
    const original = document.querySelector('.marquee-set--original');
    const clone = document.querySelector('.marquee-set--clone');
    if (!original || !clone) return;
    clone.innerHTML = original.innerHTML;
  })();
</script>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    cursor: default;
    overflow: hidden;
  }

  .announcement-bar__marquee-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .announcement-bar__marquee {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: max-content;
    animation: marquee-scroll calc(var(--marquee-speed) * 4s) linear infinite;
    cursor: default;
  }

  /* Override theme's grid stacking for marquee */
  .marquee-set {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    grid: unset !important;
  }

  .marquee-set .announcement-bar__slides {
    display: flex !important;
    flex-direction: row !important;
    grid: unset !important;
    width: auto !important;
    max-width: none !important;
    margin: 0 !important;
  }

  .marquee-set .announcement-bar__slide {
    grid-area: unset !important;
    opacity: 1 !important;
    visibility: visible !important;
    position: relative !important;
    white-space: nowrap;
    padding-inline: 2.5rem;
  }

  .marquee-set .announcement-bar__slide::after {
    content: '✦';
    margin-left: 2.5rem;
    opacity: 0.5;
  }

  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
