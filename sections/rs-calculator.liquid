{
  "name": "RS - Health Calculator",
  "settings": [
    { "type": "header", "content": "Stepper Labels" },
    { "type": "text", "id": "step1_label", "label": "Step 1 Label", "default": "Goal" },
    { "type": "text", "id": "step2_label", "label": "Step 2 Label", "default": "Questionnaire" },
    { "type": "text", "id": "step3_label", "label": "Step 3 Label", "default": "Personal Information" },
    { "type": "text", "id": "step4_label", "label": "Step 4 Label", "default": "Score" },
    { "type": "header", "content": "Step 1 - Intro" },
    { "type": "text", "id": "step1_title", "label": "Card Title", "default": "Diet plans" },
    { "type": "text", "id": "intro_heading", "label": "Heading", "default": "Know your health" },
    { "type": "richtext", "id": "intro_text", "label": "Body Text" },
    { "type": "image_picker", "id": "intro_image", "label": "Intro Image" },
    { "type": "text", "id": "intro_image_label", "label": "Image Caption", "default": "Quality of life" },
    { "type": "url", "id": "terms_url", "label": "Terms & Conditions URL" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer Text", "default": "Consult your doctor before any changes, especially with health conditions or allergies. Right Shift and TGHC are not liable for any adverse health effects." },
    { "type": "header", "content": "Step 2 - Questions" },
    { "type": "text", "id": "step2_title", "label": "Card Title", "default": "Energy Levels" }
  ],
  "presets": [{ "name": "RS - Health Calculator" }]
}
