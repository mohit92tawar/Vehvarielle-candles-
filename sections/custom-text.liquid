<section 
  class="luminous-text-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div 
    class="luminous-container {% if section.settings.width == 'fit' %}page-width{% endif %}"
  >
    <div 
      class="luminous-text"
      style="
        color: {{ section.settings.text_color }};
        font-size: {{ section.settings.font_size }}px;
        line-height: {{ section.settings.line_height }};
        font-weight: {{ section.settings.font_weight }};
        text-align: {{ section.settings.alignment }};
        max-width: {{ section.settings.max_width }}px;
      "
    >
      {{ section.settings.text }}
    </div>
  </div>
</section>

<style>
.luminous-text-section {
  width: 100%;
}

.luminous-container {
  margin: 0 auto;
  display: flex;
  justify-content: center; /* FIX: perfect center */
}

.luminous-text {
  width: 100%;
  margin: 0 auto;
}

/* ✅ MOBILE FIX */
@media screen and (max-width: 768px) {
  .luminous-text {
    max-width: 88% !important;
    font-size: calc({{ section.settings.font_size }}px - 4px);
    line-height: 1.6;
    text-align: center !important; /* FORCE CENTER */
  }
}

/* EXTRA SMALL DEVICES */
@media screen and (max-width: 480px) {
  .luminous-text {
    max-width: 92% !important;
    font-size:18px;
  }
}
</style>

{% schema %}
{
  "name": "Luminous Text Advanced",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Driven by purposeful design, each candle is a luminous moment, perfecting your surroundings with effortless beauty and subtle complexity.</p>"
    },

    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "full", "label": "Full Width" }
      ],
      "default": "fit"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "default": 800
    },

    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 12,
      "max": 60,
      "step": 1,
      "default": 20
    },

    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },

    {
      "type": "select",
      "id": "line_height",
      "label": "Line Height",
      "options": [
        { "value": "1.4", "label": "Tight" },
        { "value": "1.6", "label": "Normal" },
        { "value": "1.8", "label": "Relaxed" }
      ],
      "default": "1.8"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5a3e2b"
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f3ef"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Luminous Text Advanced"
    }
  ]
}
{% endschema %}