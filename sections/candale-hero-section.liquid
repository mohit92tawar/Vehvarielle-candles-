{% comment %}
  Section: Candle Hero Split
  Image + Text layout - Diptyque style
{% endcomment %}

<section id="candle-hero-{{ section.id }}">
  <div class="ch-image-col">
    {% if section.settings.main_image != blank %}
      <img
        src="{{ section.settings.main_image | image_url: width: 1000 }}"
        alt="{{ section.settings.main_image.alt | escape }}"
        class="ch-main-img"
        loading="lazy"
        width="1000"
        height="800"
      >
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ch-main-img placeholder-svg' }}
    {% endif %}
  </div>

  <div class="ch-content-col">
    {% if section.settings.heading != blank %}
      <h2 class="ch-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ch-product-thumb">
      {% if section.settings.product_image != blank %}
        <img
          src="{{ section.settings.product_image | image_url: width: 300 }}"
          alt="{{ section.settings.product_image.alt | escape }}"
          class="ch-thumb-img"
          loading="lazy"
          width="160"
          height="200"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'ch-thumb-img placeholder-svg' }}
      {% endif %}
    </div>

    {% if section.settings.description != blank %}
      <p class="ch-description">{{ section.settings.description }}</p>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="ch-link" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  #candle-hero-{{ section.id }} {
    --hero-bg: {{ section.settings.background_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-heading-font-size: {{ section.settings.heading_size }}px;

    display: flex;
    align-items: stretch;
    min-height: 480px;
    background-color: var(--hero-bg, #f5f0eb);
    overflow: hidden;
  }

  /* Left: Image Column */
  #candle-hero-{{ section.id }} .ch-image-col {
    flex: 0 0 50%;
    max-width: 700px;
    position: relative;
    overflow: hidden;
  }

  #candle-hero-{{ section.id }} .ch-main-img,
  #candle-hero-{{ section.id }} .ch-image-col .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right: Content Column */
  #candle-hero-{{ section.id }} .ch-content-col {
    flex: 0 0 50%;
    max-width: 50%;
    padding: 52px 56px 48px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    color: var(--hero-text, #4A2A15);
  }

  /* Heading */
  #candle-hero-{{ section.id }} .ch-heading {
    font-size: var(--hero-heading-font-size, 75px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    color: var(--hero-text, #4A2A15);
  }

  /* Product Thumbnail */
  #candle-hero-{{ section.id }} .ch-product-thumb {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #candle-hero-{{ section.id }} .ch-thumb-img,
  #candle-hero-{{ section.id }} .ch-product-thumb .placeholder-svg {
    width: 240px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* Description */
  #candle-hero-{{ section.id }} .ch-description {
    font-size: 18px;
    line-height: 1.7;
    color: var(--hero-text, #4A2A15);
    max-width:425px;
    margin: 0;
  }

  /* CTA Link */
  #candle-hero-{{ section.id }} .ch-link {
    display: inline-block;
    font-size: 18px;
    {% comment %} color: var(--hero-text, #492914); {% endcomment %}
     color: #492914;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    letter-spacing: 0.02em;
    transition: opacity 0.2s ease;
    width: fit-content;
    margin-top: 4px;
  }

  #candle-hero-{{ section.id }} .ch-link:hover {
    opacity: 0.6;
  }

  /* Responsive */
  @media screen and (max-width: 900px) {
    #candle-hero-{{ section.id }} {
      flex-direction: column;
    }

    #candle-hero-{{ section.id }} .ch-image-col,
    #candle-hero-{{ section.id }} .ch-content-col {
      flex: 0 0 100%;
      max-width: 100%;
    }

    #candle-hero-{{ section.id }} .ch-image-col {
      height: 340px;
    }

    #candle-hero-{{ section.id }} .ch-content-col {
      padding: 36px 28px 40px;
      gap: 20px;
    }

    #candle-hero-{{ section.id }} .ch-heading {
      font-size: 32px;
    }
     #candle-hero-{{ section.id }} .ch-description {
    font-size: 16px;
     }
  }

  @media screen and (max-width: 480px) {
    #candle-hero-{{ section.id }} .ch-image-col {
      height: 260px;
    }

    #candle-hero-{{ section.id }} .ch-content-col {
      padding: 28px 20px 32px;
    }

    #candle-hero-{{ section.id }} .ch-heading {
      font-size: 36px;
    }

    #candle-hero-{{ section.id }} .ch-thumb-img {
      width: 100px;
    }
  }
</style>

{% schema %}
{
  "name": "Candle Hero Split",
  "tag": "section",
  "class": "section-candle-hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Lifestyle Image (Left)"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Thumbnail Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The hour learns to pause."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 44
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "It begins quietly. Light shifts, the room listens, and something ordinary becomes enough without explanation, instruction, or interruption."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button / Link Text",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button / Link URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f0eb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A2A15"
    }
  ],
  "presets": [
    {
      "name": "Candle Hero Split"
    }
  ]
}
{% endschema %}
