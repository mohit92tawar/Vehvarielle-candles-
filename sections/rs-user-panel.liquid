    appId:             "1:13670469414:web:f0949b066b363de928fbe7"
  };

  import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged, signOut }
                              from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc, updateDoc, arrayUnion, serverTimestamp,
           collection, addDoc, getDocs, orderBy, query }
                              from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const sid = '{{ section.id }}';
  // ✅ KEY FIX: Use default app (no name) — shared with header so auth state is instant
  const app = getApps().length ? getApp() : initializeApp(FIREBASE_CONFIG);

  const auth = getAuth(app);
  const db   = getFirestore(app);
  const googleProvider = new GoogleAuthProvider();

  // ── Recipes data ──
  const RECIPES = [
    { title: 'Green Smoothie Bowl',   emoji: '🥗', tag: 'Breakfast', bg: '#e8f5e9' },
    { title: 'Lentil Veggie Soup',    emoji: '🍲', tag: 'Lunch',     bg: '#fff3e0' },
    { title: 'Quinoa Salad',          emoji: '🥙', tag: 'Lunch',     bg: '#e3f2fd' },
    { title: 'Banana Oat Pancakes',   emoji: '🥞', tag: 'Breakfast', bg: '#fce4ec' },
    { title: 'Chickpea Curry',        emoji: '🍛', tag: 'Dinner',    bg: '#fff9c4' },
    { title: 'Berry Chia Pudding',    emoji: '🍓', tag: 'Snack',     bg: '#f3e5f5' },
    { title: 'Sprout Veggie Bowl',    emoji: '🥦', tag: 'Lunch',     bg: '#e8f5e9' },
    { title: 'Millet Khichdi',        emoji: '🍚', tag: 'Dinner',    bg: '#fff3e0' },
    { title: 'Turmeric Milk',         emoji: '🥛', tag: 'Drink',     bg: '#fffde7' },
    { title: 'Fruit Chaat',           emoji: '🍎', tag: 'Snack',     bg: '#fce4ec' },
    { title: 'Moong Dal Cheela',      emoji: '🫓', tag: 'Breakfast', bg: '#e3f2fd' },
    { title: 'Walnut Energy Balls',   emoji: '🟤', tag: 'Snack',     bg: '#efebe9' },
  ];

  // ── Show state ──
  function showState(state) {
    document.getElementById('rs-panel-loading-' + sid).style.display = state === 'loading' ? 'block' : 'none';
    document.getElementById('rs-panel-login-' + sid).style.display   = state === 'login'   ? 'block' : 'none';
    document.getElementById('rs-panel-dash-' + sid).style.display    = state === 'dash'    ? 'block' : 'none';
  }

  // ── Profile completion ──
  function calcCompletion(data) {
    const fields = ['firstName','lastName','phone','age','gender','city'];
    const filled = fields.filter(f => data[f] && String(data[f]).trim() !== '').length;
    return Math.round((filled / fields.length) * 100);
  }

  // ── Update header ──
  function updateHeader(user, data) {
    const firstName = data.firstName || (user.displayName || 'User').split(' ')[0];
    const lastName  = data.lastName  || (user.displayName || '').split(' ').slice(1).join(' ');
    const fullName  = (firstName + ' ' + lastName).trim() || 'User';

    document.getElementById('rs-display-name-' + sid).textContent  = fullName;
    document.getElementById('rs-display-email-' + sid).textContent = user.email || user.phoneNumber || '';

    const pct = calcCompletion(data);
    document.getElementById('rs-progress-fill-' + sid).style.width  = pct + '%';
    document.getElementById('rs-progress-label-' + sid).textContent = pct + '%';

    const initial = (firstName[0] || 'U').toUpperCase();
    const avatarEl = document.getElementById('rs-avatar-' + sid);
    const settingsAvatarEl = document.getElementById('rs-settings-avatar-' + sid);

    if (data.photoURL || user.photoURL) {
      const src = data.photoURL || user.photoURL;
      avatarEl.innerHTML = `<img src="${src}" alt="avatar">`;
      settingsAvatarEl.innerHTML = `<img src="${src}" alt="avatar">`;
    } else {
      avatarEl.textContent = initial;
      settingsAvatarEl.textContent = initial;
    }
  }

  // ── Fill settings form ──
  function fillSettingsForm(user, data) {
    document.getElementById('rs-fname-' + sid).value  = data.firstName || '';
    document.getElementById('rs-lname-' + sid).value  = data.lastName  || '';
    document.getElementById('rs-pemail-' + sid).value = user.email || '';
    document.getElementById('rs-pphone-' + sid).value = data.phone || user.phoneNumber || '';
    document.getElementById('rs-age-' + sid).value    = data.age   || '';
    document.getElementById('rs-gender-' + sid).value = data.gender || '';
    document.getElementById('rs-city-' + sid).value   = data.city  || '';
  }

  // ── Load Activity ──
  function loadActivity(data) {
    const activity = (data.activity || []).slice().reverse().slice(0, 15);
    const listEl = document.getElementById('rs-activity-list-' + sid);
    if (!activity.length) {
      listEl.innerHTML = '<div class="rs-empty-state">⚡ No activity yet. Take the health quiz to get started!</div>';
      return;
    }
    listEl.innerHTML = activity.map(a => `
      <div class="rs-activity-item">
        <div class="rs-activity-item__icon-wrap">${a.icon || '⚡'}</div>
        <div>
          <div class="rs-activity-item__title">${a.title}</div>
          <div class="rs-activity-item__sub">${a.sub || ''}</div>
        </div>
      </div>`).join('');
  }

  // ── Load Scores ──
  function loadScores(data) {
    const scores = (data.scores || []).slice().reverse();
    const listEl = document.getElementById('rs-scores-list-' + sid);
    if (!scores.length) {
      listEl.innerHTML = '<div class="rs-empty-state">🏆 No scores yet. Take the health quiz!</div>';
      return;
    }
    listEl.innerHTML = scores.map(s => {
      const pct   = Math.round((s.score / 260) * 100);
      const label = s.score >= 200 ? 'Excellent 🌟' : s.score >= 150 ? 'Great 👍' : s.score >= 100 ? 'Good 💪' : 'Keep Going 🔥';
      const date  = s.takenAt || (s.date && s.date.seconds ? new Date(s.date.seconds*1000).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : 'N/A');
      return `
        <div class="rs-score-card">
          <div class="rs-score-card__num">${s.score}</div>
          <div class="rs-score-card__info">
            <div class="rs-score-card__date">📅 ${date}</div>
            <div class="rs-score-card__bar-wrap">
              <div class="rs-score-card__bar-fill" style="width:${pct}%"></div>
            </div>
            <div class="rs-score-card__label">${label} — ${pct}% of max (260)</div>
          </div>
        </div>`;
    }).join('');
  }

  // ── Load Notifications ──
  function loadNotifications(data) {
    const notifs  = (data.notifications || []).slice().reverse();
    const listEl  = document.getElementById('rs-notif-list-' + sid);
    const badge   = document.getElementById('rs-notif-badge-' + sid);
    const unread  = notifs.filter(n => !n.read).length;
    if (unread > 0) { badge.textContent = unread; badge.style.display = 'inline'; }
    if (!notifs.length) {
      listEl.innerHTML = '<div class="rs-empty-state">🔔 No notifications yet.</div>'; return;
    }
    listEl.innerHTML = notifs.map(n => `
      <div class="rs-notif-item ${n.read ? '' : 'unread'}">
        <div class="rs-notif-item__icon">${n.icon || '🔔'}</div>
        <div>
          <div class="rs-notif-item__title">${n.title}</div>
          <div class="rs-notif-item__time">${n.time || ''}</div>
        </div>
      </div>`).join('');
  }

  // ── Load Recipes ──
  function loadRecipes() {
    document.getElementById('rs-recipe-grid-' + sid).innerHTML = RECIPES.map(r => `
      <div class="rs-recipe-card">
        <div class="rs-recipe-card__img" style="background:${r.bg}">${r.emoji}</div>
        <div class="rs-recipe-card__body">
          <div class="rs-recipe-card__title">${r.title}</div>
          <span class="rs-recipe-card__tag">${r.tag}</span>
        </div>
      </div>`).join('');
  }

  // ── Load Discussions ──
  async function loadDiscussions() {
    const listEl = document.getElementById('rs-discussion-list-' + sid);
    try {
      const q = query(collection(db, 'discussions'), orderBy('createdAt', 'desc'));
      const snap = await getDocs(q);
      if (snap.empty) {
        listEl.innerHTML = '<div class="rs-empty-state">💬 No posts yet. Be the first to share!</div>'; return;
      }
      listEl.innerHTML = snap.docs.map(d => {
        const data = d.data();
        return `
          <div class="rs-discussion-item">
            <div class="rs-discussion-item__title">${data.text || ''}</div>
            <div class="rs-discussion-item__meta">
              <span>👤 ${data.userName || 'Anonymous'}</span>
              <span>📅 ${data.postedAt || ''}</span>
              <span class="rs-discussion-item__tag">Health</span>
            </div>
          </div>`;
      }).join('');
    } catch(e) {
      listEl.innerHTML = '<div class="rs-empty-state">💬 Could not load discussions.</div>';
    }
  }

  // ── Post Discussion ──
  window.rsPostDiscussion = async function(id) {
    const user = auth.currentUser;
    if (!user) { alert('Please login first.'); return; }
    const input = document.getElementById('rs-discuss-input-' + id);
    const text = input.value.trim();
    if (!text) { alert('Please write something first!'); return; }
    try {
      const snap = await getDoc(doc(db, 'users', user.uid));
      const userData = snap.exists() ? snap.data() : {};
      const userName = (userData.firstName || user.displayName || 'User');
      await addDoc(collection(db, 'discussions'), {
        text, userName, userId: user.uid,
        postedAt: new Date().toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }),
        createdAt: serverTimestamp()
      });
      // Add activity
      await updateDoc(doc(db, 'users', user.uid), {
        activity: arrayUnion({
          icon: '💬', title: 'Posted in community discussion',
          sub: new Date().toLocaleDateString('en-IN')
        })
      });
      input.value = '';
      await loadDiscussions();
    } catch(e) {
      alert('Failed to post. Try again.');
    }
  };

  // ── Auth state ──
  onAuthStateChanged(auth, async (user) => {
    if (!user) { showState('login'); return; }
    showState('loading');
    try {
      const userRef = doc(db, 'users', user.uid);
      let snap = await getDoc(userRef);
      let userData = {};

      if (!snap.exists()) {
        // New user via panel login (no quiz)
        const nameParts = (user.displayName || '').split(' ');
        const now = new Date().toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
        userData = {
          firstName: nameParts[0] || '',
          lastName: nameParts.slice(1).join(' ') || '',
          email: user.email || '',
          phone: user.phoneNumber || '',
          photoURL: user.photoURL || '',
          age: '', gender: '', city: '',
          scores: [], activity: [{ icon: '👋', title: 'Joined Right Shift', sub: now }],
          notifications: [{ icon: '🎉', title: 'Welcome to Right Shift!', time: now, read: false }],
          createdAt: serverTimestamp()
        };
        await setDoc(userRef, userData);
        snap = await getDoc(userRef);
        userData = snap.data();
      } else {
        userData = snap.data();
      }

      updateHeader(user, userData);
      fillSettingsForm(user, userData);
      loadActivity(userData);
      loadScores(userData);
      loadNotifications(userData);
      loadRecipes();
      await loadDiscussions();

      showState('dash');
    } catch(e) {
      console.error('Dashboard error:', e);
      showState('login');
    }
  });

  // ── Google Login ──
  window.rsPanelGoogleLogin = async function(id) {
    try { await signInWithPopup(auth, googleProvider); }
    catch(e) { alert('Login failed: ' + e.message); }
  };

  // ── Logout ──
  window.rsPanelLogout = async function(id) {
    if (confirm('Are you sure you want to log out?')) {
      await signOut(auth);
      showState('login');
    }
  };

  // ── Tab switch ──
  window.rsPanelTab = function(id, tab) {
    ['activity','settings','recipes','scores','discussions','notifications'].forEach(t => {
      document.getElementById('rs-section-' + t + '-' + id)?.classList.remove('active');
      document.getElementById('rs-tab-' + t + '-' + id)?.classList.remove('active');
    });
    document.getElementById('rs-section-' + tab + '-' + id)?.classList.add('active');
    document.getElementById('rs-tab-' + tab + '-' + id)?.classList.add('active');
    // Mark notifications read
    if (tab === 'notifications') {
      const badge = document.getElementById('rs-notif-badge-' + id);
      if (badge) badge.style.display = 'none';
    }
  };

  // ── Save Profile ──
  window.rsSaveProfile = async function(id) {
    const user = auth.currentUser;
    if (!user) return;
    const msgEl = document.getElementById('rs-settings-msg-' + id);
    msgEl.className = 'rs-panel-msg'; msgEl.style.display = 'none';
    const profileData = {
      firstName: document.getElementById('rs-fname-' + id).value.trim(),
      lastName:  document.getElementById('rs-lname-' + id).value.trim(),
      phone:     document.getElementById('rs-pphone-' + id).value.trim(),
      age:       document.getElementById('rs-age-' + id).value.trim(),
      gender:    document.getElementById('rs-gender-' + id).value,
      city:      document.getElementById('rs-city-' + id).value.trim(),
      updatedAt: serverTimestamp()
    };
    try {
      await updateDoc(doc(db, 'users', user.uid), profileData);
      await updateDoc(doc(db, 'users', user.uid), {
        activity: arrayUnion({ icon: '✏️', title: 'Updated profile', sub: new Date().toLocaleDateString('en-IN') })
      });
      const snap = await getDoc(doc(db, 'users', user.uid));
      updateHeader(user, snap.data());
      msgEl.textContent = '✅ Profile saved successfully!';
      msgEl.className = 'rs-panel-msg success';
    } catch(e) {
      msgEl.textContent = '❌ Error saving. Try again.';
      msgEl.className = 'rs-panel-msg error';
    }
  };
</script>

{% schema %}
{
  "name": "RS - User Dashboard",
  "settings": [],
  "presets": [{ "name": "RS - User Dashboard" }]
}
{% endschema %}
