<style>
@import url('https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700;900&display=swap');
.rs-panel * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Urbanist', sans-serif; }
.rs-panel { background: #f0e8d8; min-height: 100vh; padding: 32px 16px 60px; }
.rs-panel__wrap { max-width: 1000px; margin: 0 auto; }

/* LOADING */
.rs-panel__loading { text-align: center; padding: 80px 20px; color: #555; }
.rs-spinner { width: 48px; height: 48px; border: 4px solid #ddd; border-top-color: #1a5c2a; border-radius: 50%; animation: rsSpin .8s linear infinite; margin: 0 auto 16px; }
@keyframes rsSpin { to { transform: rotate(360deg); } }

/* LOGIN PROMPT */
.rs-panel__login-prompt { background: #fff; border-radius: 20px; padding: 48px 32px; text-align: center; box-shadow: 0 4px 24px rgba(0,0,0,.1); max-width: 440px; margin: 60px auto; }
.rs-panel__login-prompt h2 { font-size: 1.6rem; font-weight: 900; color: #1a1a1a; margin-bottom: 8px; }
.rs-panel__login-prompt p { font-size: .95rem; color: #666; margin-bottom: 28px; }
.rs-login-google-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 14px 20px; border: 1.5px solid #ddd; border-radius: 50px; background: #fff; color: #333; font-size: .95rem; font-weight: 600; cursor: pointer; transition: all .2s; margin-bottom: 12px; }
.rs-login-google-btn:hover { border-color: #4285f4; background: #f8f9ff; }

/* PROFILE HEADER */
.rs-profile-header {
  background: #1a5c2a;
  border-radius: 20px 20px 0 0;
  padding: 32px 40px;
  display: flex;
  align-items: center;
  gap: 28px;
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
}
.rs-profile-header::before { content: ''; position: absolute; top: -60px; right: -60px; width: 240px; height: 240px; border-radius: 50%; background: rgba(255,255,255,.05); }
.rs-profile-header::after  { content: ''; position: absolute; bottom: -40px; right: 100px; width: 160px; height: 160px; border-radius: 50%; background: rgba(255,255,255,.04); }
.rs-profile-avatar {
  width: 100px; height: 100px; border-radius: 50%;
  border: 4px solid rgba(255,255,255,.5);
  flex-shrink: 0; background: #2d7a40;
  display: flex; align-items: center; justify-content: center;
  font-size: 2.6rem; color: #fff; font-weight: 900;
  cursor: pointer; overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,.2);
}
.rs-profile-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.rs-profile-info { flex: 1; min-width: 0; }
.rs-profile-info h2 { font-size: 1.6rem; font-weight: 900; color: #fff; margin-bottom: 6px; letter-spacing: -.3px; }
.rs-profile-email { font-size: .85rem; color: rgba(255,255,255,.65); margin-bottom: 14px; }
.rs-profile-progress-wrap { display: flex; align-items: center; gap: 10px; }
.rs-profile-progress-bar { flex: 1; height: 8px; background: rgba(255,255,255,.2); border-radius: 4px; overflow: hidden; }
.rs-profile-progress-fill { height: 100%; background: linear-gradient(90deg, #f5c518, #ffd700); border-radius: 4px; transition: width .6s ease; }
.rs-profile-progress-label {
  font-size: .75rem; color: #fff; font-weight: 700;
  background: #f5c518; color: #1a1a1a;
  padding: 2px 8px; border-radius: 20px;
  white-space: nowrap;
}
.rs-profile-complete-msg { font-size: .78rem; color: rgba(255,255,255,.55); margin-top: 6px; }

/* BODY LAYOUT */
.rs-dash-card { border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,.12); overflow: hidden; }
.rs-panel__body { display: grid; grid-template-columns: 240px 1fr; gap: 0; align-items: start; background: #fff; overflow: hidden; }
@media (max-width: 700px) { .rs-panel__body { grid-template-columns: 1fr; } }

/* SIDEBAR */
.rs-sidebar { background: #fff; border-right: 1px solid #f0f0f0; padding-bottom: 16px; }
.rs-sidebar__title { padding: 24px 24px 16px; font-size: 1.3rem; font-weight: 900; color: #1a1a1a; }
.rs-sidebar__menu { list-style: none; padding: 0; }
.rs-sidebar__item {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 24px; cursor: pointer;
  transition: background .15s; font-size: .92rem; font-weight: 600;
  color: #555; border-left: 3px solid transparent;
  position: relative;
}
.rs-sidebar__item:hover { background: #fafafa; color: #1a1a1a; }
.rs-sidebar__item.active { background: #fffbf0; color: #1a1a1a; border-left-color: #f5c518; }
.rs-sidebar__item.active .rs-sidebar__icon-wrap { background: #f5c518; }
.rs-sidebar__icon-wrap {
  width: 34px; height: 34px; border-radius: 8px;
  background: #f5f5f5; display: flex; align-items: center;
  justify-content: center; font-size: 1rem; flex-shrink: 0;
  transition: background .15s;
}
.rs-sidebar__chevron { margin-left: auto; font-size: .75rem; color: #bbb; }
.rs-sidebar__item.active .rs-sidebar__chevron { color: #888; }
.rs-sidebar__divider { height: 1px; background: #f0f0f0; margin: 8px 0; }
.rs-logout-btn {
  width: calc(100% - 32px); margin: 8px 16px 16px;
  padding: 12px; background: #1a1a1a; border: none;
  border-radius: 50px; color: #fff; font-weight: 700;
  font-size: .9rem; cursor: pointer; transition: background .2s;
  font-family: inherit;
}
.rs-logout-btn:hover { background: #333; }

/* CONTENT AREA */
.rs-content { padding: 28px 32px; min-height: 480px; }
.rs-content__section { display: none; }
.rs-content__section.active { display: block; }
.rs-content__title { font-size: 1.2rem; font-weight: 900; color: #1a1a1a; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 2px solid #f5f5f5; }

/* ACTIVITY */
.rs-activity-list { display: flex; flex-direction: column; gap: 10px; }
.rs-activity-item {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 18px; background: #fffbf0;
  border-radius: 12px; border: 1px solid #f0e8c8;
  transition: box-shadow .15s;
}
.rs-activity-item:hover { box-shadow: 0 2px 12px rgba(0,0,0,.07); }
.rs-activity-item__icon-wrap {
  width: 40px; height: 40px; border-radius: 10px;
  background: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 1.3rem; flex-shrink: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
}
.rs-activity-item__title { font-size: .9rem; font-weight: 700; color: #1a1a1a; margin-bottom: 2px; }
.rs-activity-item__sub { font-size: .76rem; color: #999; }
.rs-empty-state { text-align: center; padding: 48px 20px; color: #bbb; font-size: .9rem; }

/* SCORES */
.rs-scores-list { display: flex; flex-direction: column; gap: 12px; }
.rs-score-card { padding: 18px 20px; border-radius: 12px; background: #f0faf3; border: 1.5px solid #c8e6c9; display: flex; align-items: center; gap: 16px; }
.rs-score-card__num { font-size: 2.2rem; font-weight: 900; color: #1a5c2a; min-width: 64px; text-align: center; }
.rs-score-card__info { flex: 1; }
.rs-score-card__date { font-size: .8rem; color: #888; margin-bottom: 6px; }
.rs-score-card__bar-wrap { height: 7px; background: #e0e0e0; border-radius: 4px; overflow: hidden; }
.rs-score-card__bar-fill { height: 100%; background: linear-gradient(90deg,#1a5c2a,#2d9a48); border-radius: 4px; }
.rs-score-card__label { font-size: .78rem; color: #1a5c2a; font-weight: 700; margin-top: 5px; }

/* SETTINGS */
.rs-settings-form { display: flex; flex-direction: column; gap: 16px; }
.rs-settings-avatar-wrap { display: flex; align-items: center; gap: 20px; margin-bottom: 4px; }
.rs-settings-avatar { width: 80px; height: 80px; border-radius: 50%; background: #1a5c2a; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #fff; font-weight: 900; overflow: hidden; flex-shrink: 0; }
.rs-settings-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.rs-settings-group { display: flex; flex-direction: column; gap: 6px; }
.rs-settings-label { font-size: .85rem; color: #555; font-weight: 600; }
.rs-settings-input { padding: 12px 14px; border: 1.5px solid #e8e8e8; border-radius: 10px; font-size: .92rem; outline: none; color: #1a1a1a; font-family: inherit; transition: border .2s; background: #fafafa; }
.rs-settings-input:focus { border-color: #1a5c2a; box-shadow: 0 0 0 3px rgba(26,92,42,.08); background: #fff; }
.rs-settings-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 500px) { .rs-settings-row { grid-template-columns: 1fr; } }
.rs-settings-save { padding: 14px; background: #1a1a1a; color: #fff; border: none; border-radius: 50px; font-size: 1rem; font-weight: 700; cursor: pointer; font-family: inherit; transition: background .2s; }
.rs-settings-save:hover { background: #333; }

/* RECIPE */
.rs-recipe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
.rs-recipe-card { border-radius: 14px; overflow: hidden; border: 1px solid #eee; transition: all .2s; cursor: pointer; background: #fff; }
.rs-recipe-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.1); transform: translateY(-2px); }
.rs-recipe-card__img { height: 100px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
.rs-recipe-card__body { padding: 12px; }
.rs-recipe-card__title { font-size: .83rem; font-weight: 700; color: #1a1a1a; margin-bottom: 5px; }
.rs-recipe-card__tag { font-size: .68rem; color: #1a5c2a; background: #f0faf3; padding: 2px 8px; border-radius: 20px; display: inline-block; font-weight: 600; }

/* DISCUSSIONS */
.rs-discussion-list { display: flex; flex-direction: column; gap: 10px; }
.rs-discussion-item { padding: 16px 18px; border-radius: 12px; border: 1px solid #eee; background: #fafafa; transition: border-color .2s; }
.rs-discussion-item:hover { border-color: #ddd; }
.rs-discussion-item__title { font-size: .92rem; font-weight: 700; color: #1a1a1a; margin-bottom: 8px; line-height: 1.4; }
.rs-discussion-item__meta { font-size: .76rem; color: #999; display: flex; gap: 12px; flex-wrap: wrap; }
.rs-discussion-item__tag { background: #f0faf3; color: #1a5c2a; padding: 2px 8px; border-radius: 20px; font-size: .68rem; font-weight: 600; }
.rs-discuss-compose { margin-bottom: 20px; }
.rs-discuss-compose textarea { width: 100%; padding: 14px 16px; border: 1.5px solid #e8e8e8; border-radius: 12px; font-size: .9rem; font-family: inherit; resize: vertical; min-height: 84px; outline: none; background: #fafafa; }
.rs-discuss-compose textarea:focus { border-color: #1a5c2a; background: #fff; }
.rs-discuss-post-btn { margin-top: 10px; padding: 11px 28px; background: #1a1a1a; color: #fff; border: none; border-radius: 50px; font-size: .9rem; font-weight: 700; cursor: pointer; font-family: inherit; transition: background .2s; }
.rs-discuss-post-btn:hover { background: #333; }

/* NOTIFICATIONS */
.rs-notif-list { display: flex; flex-direction: column; gap: 10px; }
.rs-notif-item { display: flex; gap: 14px; align-items: flex-start; padding: 14px 18px; border-radius: 12px; background: #fafafa; border: 1px solid #eee; }
.rs-notif-item.unread { background: #f0faf3; border-color: #c8e6c9; }
.rs-notif-item__icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 1px; }
.rs-notif-item__title { font-size: .88rem; font-weight: 700; color: #1a1a1a; margin-bottom: 2px; }
.rs-notif-item__time { font-size: .75rem; color: #bbb; }

/* MSG */
.rs-panel-msg { padding: 12px 16px; border-radius: 10px; font-size: .85rem; font-weight: 600; margin-bottom: 12px; display: none; }
.rs-panel-msg.success { background: #f0faf3; color: #1a5c2a; border: 1px solid #c8e6c9; display: block; }
.rs-panel-msg.error { background: #fff5f5; color: #e53935; border: 1px solid #ffcdd2; display: block; }

/* BADGE */
.rs-badge { margin-left: auto; background: #e53935; color: #fff; font-size: .65rem; font-weight: 700; padding: 2px 7px; border-radius: 20px; display: none; }

@media (max-width: 700px) {
  .rs-profile-header { padding: 24px 20px; flex-direction: column; text-align: center; border-radius: 20px 20px 0 0; }
  .rs-panel__body { border-radius: 0 0 20px 20px; }
  .rs-content { padding: 20px 16px; }
  .rs-sidebar { border-right: none; border-bottom: 1px solid #f0f0f0; }
  .rs-profile-avatar { width: 80px; height: 80px; font-size: 2rem; }
}
</style>

<div class="rs-panel" id="rs-panel-{{ section.id }}">
  <div class="rs-panel__wrap">

    <!-- LOADING -->
    <div class="rs-panel__loading" id="rs-panel-loading-{{ section.id }}">
      <div class="rs-spinner"></div>
      <p>Loading your dashboard...</p>
    </div>

    <!-- LOGIN PROMPT -->
    <div class="rs-panel__login-prompt" id="rs-panel-login-{{ section.id }}" style="display:none;">
      <div style="font-size:3rem;margin-bottom:12px;">👤</div>
      <h2>Welcome to Right Shift</h2>
      <p>Login to view your health dashboard, scores, and more.</p>
      <button class="rs-login-google-btn" onclick="rsPanelGoogleLogin('{{ section.id }}')">
