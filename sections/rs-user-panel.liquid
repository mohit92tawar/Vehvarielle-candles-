        Continue with Google
      </button>
      <p style="font-size:.8rem;color:#aaa;margin-top:8px;">Or complete the health quiz first to create your account</p>
    </div>

    <!-- DASHBOARD -->
    <div id="rs-panel-dash-{{ section.id }}" style="display:none;">
      <div class="rs-dash-card">

