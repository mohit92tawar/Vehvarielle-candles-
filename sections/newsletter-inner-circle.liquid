      "min": 20,
      "max": 160,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding Bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Inner Circle"
    }
  ]
}
{% endschema %}
