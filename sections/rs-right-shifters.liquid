<section class="rs-shifters" id="rs-shifters-{{ section.id }}">
  <div class="rs-shifters__inner">
    <h2 class="rs-shifters__heading">{{ section.settings.heading }}</h2>
    <p class="rs-shifters__desc">{{ section.settings.description }}</p>

    <div class="rs-shifters__carousel-wrap">
      <button class="rs-shifters__btn rs-btn-prev" onclick="rsSlide('{{ section.id }}', -1)" aria-label="Previous">&#8249;</button>
      <div class="rs-shifters__viewport">
        <div class="rs-shifters__track" id="rs-track-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="rs-shifters__card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.label }}" loading="lazy">
              {% else %}
                <div class="rs-shifters__card-ph"></div>
              {% endif %}
              <div class="rs-shifters__card-overlay">{{ block.settings.label }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      <button class="rs-shifters__btn rs-btn-next" onclick="rsSlide('{{ section.id }}', 1)" aria-label="Next">&#8250;</button>
    </div>

    <a href="{{ section.settings.btn_url }}" class="rs-shifters__view-all">{{ section.settings.btn_label }}</a>
  </div>
</section>

<style>
.rs-shifters { background: #f5c518; padding: 64px 40px; text-align: center; }
.rs-shifters__inner { max-width: 1080px; margin: 0 auto; }
.rs-shifters__heading { font-size: 2.4rem; font-weight: 900; color: #1a1a1a; margin-bottom: 12px; }
.rs-shifters__desc { font-size: .97rem; color: #1a1a1a; line-height: 1.8; max-width: 680px; margin: 0 auto 44px; }
.rs-shifters__carousel-wrap { position: relative; margin-bottom: 44px; }
.rs-shifters__viewport { overflow: hidden; }
.rs-shifters__track { display: flex; gap: 20px; transition: transform .4s ease; }
.rs-shifters__card { flex: 0 0 calc(25% - 15px);
    border-radius: 16px;
    padding: 10px;
    overflow: hidden;
    position: relative;
    background: #2D2119;
    box-shadow: 0 4px 16px rgba(0, 0, 0, .15); }
.rs-shifters__card img { width: 100%; height: 300px; object-fit: cover; object-position: top; display: block; border-radius:16px; }
.rs-shifters__card-ph { width: 100%; height: 300px; background: #c8a96e; }
.rs-shifters__card-overlay {      color: #fff;
    padding: 13px 14px 0px;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
    max-width: 100%;
    margin: 0 auto; }
.rs-shifters__btn { position: absolute; top: 50%; transform: translateY(-50%); background: #fff; border: none; border-radius: 50%; width: 44px; height: 44px; font-size: 1.4rem; cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.2); z-index: 5; font-weight: bold; }
.rs-btn-prev { left: -22px; }
.rs-btn-next { right: -22px; }
.rs-shifters__view-all { display: inline-block;
    background: #2D2119;
    min-width: 250px;
    color: #fff;
    padding: 9px 64px;
    border-radius: 50px;
    font-size: 24px;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s; }
.rs-shifters__view-all:hover { background: #333; color: #fff; }

@media (max-width: 749px) {
  .rs-shifters { padding: 36px 16px; }
  .rs-shifters__card-overlay { font-size: 16px; }
  .rs-shifters__heading { font-size: 1.55rem; }
  .rs-shifters__desc { margin-bottom: 28px; }
  .rs-shifters__card { flex: 0 0 calc(60% - 10px); }
  .rs-shifters__card img, .rs-shifters__card-ph { height: 200px; }
  .rs-btn-prev { left: -14px; }
  .rs-btn-next { right: -14px; }
  .rs-shifters__view-all { padding: 14px 48px; font-size: 16px; min-width: auto;  }
}
</style>

<script>
(function() {
  var rsState = {};
  window.rsSlide = function(id, dir) {
    if (!rsState[id]) rsState[id] = 0;
    var track = document.getElementById('rs-track-' + id);
    if (!track) return;
    var cards = track.querySelectorAll('.rs-shifters__card');
    if (!cards.length) return;
    var visible = window.innerWidth <= 749 ? 1 : 4;
    var max = cards.length - visible;
    rsState[id] = Math.max(0, Math.min(rsState[id] + dir, max));
    var w = cards[0].offsetWidth + 20;
    track.style.transform = 'translateX(-' + (rsState[id] * w) + 'px)';
  };
})();
</script>

{% schema %}
{
  "name": "The Right Shifters",
  "blocks": [
    {
      "type": "shifter_card",
      "name": "Shifter Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Person Image" },
        { "type": "text", "id": "label", "label": "Card Label", "default": "Discover firsthand accounts of future" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The right shifters" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Read stories from folks who made the Shift happen. They faced challenges with courage and resilience, proving it's never too late to create a brighter, happier and healthier future. Join the inspiring journey!" },
    { "type": "text", "id": "btn_label", "label": "Button Text", "default": "View All" },
    { "type": "url", "id": "btn_url", "label": "Button URL" }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "The Right Shifters",
      "blocks": [
        { "type": "shifter_card" },
        { "type": "shifter_card" },
        { "type": "shifter_card" },
        { "type": "shifter_card" }
      ]
    }
  ]
}
{% endschema %}