{% assign custom_selfasesment = section.id | replace: '_', '' | downcase %}

{% style %}
  .health-calc-{{ custom_selfasesment }} {
    display: block;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }

  .health-calc-container-{{ custom_selfasesment }} {
    background-color: {{ section.settings.background_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: 40px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .health-calc-header-{{ custom_selfasesment }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .health-calc-title-{{ custom_selfasesment }} {
    font-size: 32px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px;
  }

  .health-calc-subtitle-{{ custom_selfasesment }} {
    font-size: 16px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .health-calc-progress-{{ custom_selfasesment }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    position: relative;
  }

  .health-calc-progress-line-{{ custom_selfasesment }} {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: {{ section.settings.progress_bg_color }};
    z-index: 0;
  }

  .health-calc-progress-fill-{{ custom_selfasesment }} {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: {{ section.settings.progress_active_color }};
    transition: width 0.3s ease;
    width: 0%;
  }

  .health-calc-progress-step-{{ custom_selfasesment }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
    flex: 1;
  }

  .health-calc-progress-circle-{{ custom_selfasesment }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ section.settings.progress_bg_color }};
    border: 3px solid {{ section.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    transition: all 0.3s ease;
    margin-bottom: 8px;
  }

  .health-calc-progress-circle-{{ custom_selfasesment }}.active {
    background-color: {{ section.settings.progress_active_color }};
    color: #ffffff;
  }

  .health-calc-progress-circle-{{ custom_selfasesment }}.completed {
    background-color: {{ section.settings.progress_active_color }};
    color: #ffffff;
  }

  .health-calc-progress-label-{{ custom_selfasesment }} {
    font-size: 12px;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
    text-align: center;
  }

  .health-calc-step-{{ custom_selfasesment }} {
    display: none;
  }

  .health-calc-step-{{ custom_selfasesment }}.active {
    display: block;
    animation: fadeIn-{{ custom_selfasesment }} 0.3s ease;
  }

  @keyframes fadeIn-{{ custom_selfasesment }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .health-calc-question-{{ custom_selfasesment }} {
    margin-bottom: 32px;
  }

  .health-calc-question-title-{{ custom_selfasesment }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 16px;
  }

  .health-calc-input-group-{{ custom_selfasesment }} {
    margin-bottom: 24px;
  }

  .health-calc-label-{{ custom_selfasesment }} {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    margin-bottom: 8px;
  }

  .health-calc-input-{{ custom_selfasesment }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    background-color: {{ section.settings.input_bg_color }};
    transition: border-color 0.3s ease;
  }

  .health-calc-input-{{ custom_selfasesment }}:focus {
    outline: none;
    border-color: {{ section.settings.progress_active_color }};
  }

  .health-calc-input-row-{{ custom_selfasesment }} {
    display: flex;
    gap: 12px;
  }

  .health-calc-input-row-{{ custom_selfasesment }} .health-calc-input-group-{{ custom_selfasesment }} {
    flex: 1;
  }

  .health-calc-select-{{ custom_selfasesment }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    background-color: {{ section.settings.input_bg_color }};
    cursor: pointer;
  }

  .health-calc-toggle-group-{{ custom_selfasesment }} {
    display: flex;
    gap: 12px;
  }

  .health-calc-toggle-btn-{{ custom_selfasesment }} {
    flex: 1;
    padding: 12px 24px;
    border: 2px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    background-color: {{ section.settings.input_bg_color }};
    color: {{ section.settings.text_color }};
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .health-calc-toggle-btn-{{ custom_selfasesment }}:hover {
    border-color: {{ section.settings.progress_active_color }};
  }

  .health-calc-toggle-btn-{{ custom_selfasesment }}.selected {
    background-color: {{ section.settings.progress_active_color }};
    border-color: {{ section.settings.progress_active_color }};
    color: #ffffff;
  }

  .health-calc-radio-group-{{ custom_selfasesment }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .health-calc-radio-option-{{ custom_selfasesment }} {
    display: flex;
    align-items: center;
    padding: 16px;
    border: 2px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    background-color: {{ section.settings.input_bg_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .health-calc-radio-option-{{ custom_selfasesment }}:hover {
    border-color: {{ section.settings.progress_active_color }};
  }

  .health-calc-radio-option-{{ custom_selfasesment }}.selected {
    background-color: {{ section.settings.progress_active_color }};
    border-color: {{ section.settings.progress_active_color }};
    color: #ffffff;
  }

  .health-calc-radio-option-{{ custom_selfasesment }} input[type="radio"] {
    margin-right: 12px;
    width: 20px;
    height: 20px;
    cursor: pointer;
  }

  .health-calc-radio-label-{{ custom_selfasesment }} {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .health-calc-options-grid-{{ custom_selfasesment }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 12px;
  }

  .health-calc-option-btn-{{ custom_selfasesment }} {
    padding: 12px 16px;
    border: 2px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    background-color: {{ section.settings.input_bg_color }};
    color: {{ section.settings.text_color }};
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .health-calc-option-btn-{{ custom_selfasesment }}:hover {
    border-color: {{ section.settings.progress_active_color }};
  }

  .health-calc-option-btn-{{ custom_selfasesment }}.selected {
    background-color: {{ section.settings.progress_active_color }};
    border-color: {{ section.settings.progress_active_color }};
    color: #ffffff;
  }

  .health-calc-actions-{{ custom_selfasesment }} {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .health-calc-btn-{{ custom_selfasesment }} {
    flex: 1;
    padding: 14px 32px;
    border: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .health-calc-btn-primary-{{ custom_selfasesment }} {
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
  }

  .health-calc-btn-primary-{{ custom_selfasesment }}:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  .health-calc-btn-secondary-{{ custom_selfasesment }} {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    border: 2px solid {{ section.settings.input_border_color }};
  }

  .health-calc-btn-secondary-{{ custom_selfasesment }}:hover {
    border-color: {{ section.settings.progress_active_color }};
  }

  .health-calc-modal-{{ custom_selfasesment }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .health-calc-modal-{{ custom_selfasesment }}.active {
    display: flex;
  }

  .health-calc-modal-content-{{ custom_selfasesment }} {
    background-color: {{ section.settings.background_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: 40px;
    max-width: 500px;
    width: 100%;
    position: relative;
    animation: slideUp-{{ custom_selfasesment }} 0.3s ease;
  }

  @keyframes slideUp-{{ custom_selfasesment }} {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .health-calc-modal-close-{{ custom_selfasesment }} {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .health-calc-modal-close-{{ custom_selfasesment }}:hover {
    opacity: 1;
  }

  .health-calc-score-display-{{ custom_selfasesment }} {
    text-align: center;
  }

  .health-calc-score-title-{{ custom_selfasesment }} {
    font-size: 24px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 24px;
  }

  .health-calc-gauge-{{ custom_selfasesment }} {
    width: 200px;
    height: 200px;
    margin: 0 auto 24px;
  }

  .health-calc-score-value-{{ custom_selfasesment }} {
    font-size: 48px;
    font-weight: 700;
    color: {{ section.settings.progress_active_color }};
    margin: 0 0 8px;
  }

  .health-calc-score-category-{{ custom_selfasesment }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 24px;
  }

  .health-calc-score-category-{{ custom_selfasesment }}.low {
    color: #10b981;
  }

  .health-calc-score-category-{{ custom_selfasesment }}.medium {
    color: #f59e0b;
  }

  .health-calc-score-category-{{ custom_selfasesment }}.high {
    color: #ef4444;
  }

  .health-calc-error-{{ custom_selfasesment }} {
    color: #ef4444;
    font-size: 13px;
    margin-top: 8px;
    display: none;
  }

  .health-calc-error-{{ custom_selfasesment }}.visible {
    display: block;
  }

  @media screen and (max-width: 768px) {
    .health-calc-container-{{ custom_selfasesment }} {
      padding: 24px;
    }

    .health-calc-title-{{ custom_selfasesment }} {
      font-size: 24px;
    }

    .health-calc-progress-circle-{{ custom_selfasesment }} {
      width: 32px;
      height: 32px;
      font-size: 12px;
    }

    .health-calc-progress-label-{{ custom_selfasesment }} {
      font-size: 10px;
    }

    .health-calc-options-grid-{{ custom_selfasesment }} {
      grid-template-columns: 1fr;
    }

    .health-calc-input-row-{{ custom_selfasesment }} {
      flex-direction: column;
    }

    .health-calc-actions-{{ custom_selfasesment }} {
      flex-direction: column-reverse;
    }
  }
{% endstyle %}

<health-calc-{{ custom_selfasesment }}
  class="health-calc-{{ custom_selfasesment }}"
  data-webhook-url="{{ section.settings.webhook_url }}"
  {{ section.shopify_attributes }}
>
  <div class="health-calc-container-{{ custom_selfasesment }}">
    <div class="health-calc-header-{{ custom_selfasesment }}">
      <h1 class="health-calc-title-{{ custom_selfasesment }}">{{ section.settings.title }}</h1>
      <p class="health-calc-subtitle-{{ custom_selfasesment }}">{{ section.settings.subtitle }}</p>
    </div>

    <div class="health-calc-progress-{{ custom_selfasesment }}">
      <div class="health-calc-progress-line-{{ custom_selfasesment }}">
        <div class="health-calc-progress-fill-{{ custom_selfasesment }}" data-progress-fill></div>
      </div>
      <div class="health-calc-progress-step-{{ custom_selfasesment }}">
        <div class="health-calc-progress-circle-{{ custom_selfasesment }} active" data-step-indicator="1">1</div>
        <span class="health-calc-progress-label-{{ custom_selfasesment }}">Assessment</span>
      </div>
      <div class="health-calc-progress-step-{{ custom_selfasesment }}">
        <div class="health-calc-progress-circle-{{ custom_selfasesment }}" data-step-indicator="2">2</div>
        <span class="health-calc-progress-label-{{ custom_selfasesment }}">Questions</span>
      </div>
      <div class="health-calc-progress-step-{{ custom_selfasesment }}">
        <div class="health-calc-progress-circle-{{ custom_selfasesment }}" data-step-indicator="3">3</div>
        <span class="health-calc-progress-label-{{ custom_selfasesment }}">Personal Info</span>
      </div>
      <div class="health-calc-progress-step-{{ custom_selfasesment }}">
        <div class="health-calc-progress-circle-{{ custom_selfasesment }}" data-step-indicator="4">4</div>
        <span class="health-calc-progress-label-{{ custom_selfasesment }}">Results</span>
      </div>
    </div>

    <div class="health-calc-step-{{ custom_selfasesment }} active" data-step="1">
      <div class="health-calc-question-{{ custom_selfasesment }}">
        <label class="health-calc-label-{{ custom_selfasesment }}">Age</label>
        <div class="health-calc-input-row-{{ custom_selfasesment }}">
          <div class="health-calc-input-group-{{ custom_selfasesment }}">
            <input
              type="number"
              class="health-calc-input-{{ custom_selfasesment }}"
              data-field="age"
              placeholder="Enter your age"
              min="1"
              max="120"
            >
          </div>
          <div class="health-calc-input-group-{{ custom_selfasesment }}">
            <select class="health-calc-select-{{ custom_selfasesment }}" data-field="age_unit">
              <option value="years">Years</option>
              <option value="months">Months</option>
            </select>
          </div>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="age">Please enter your age</div>
      </div>

      <div class="health-calc-question-{{ custom_selfasesment }}">
        <label class="health-calc-label-{{ custom_selfasesment }}">Gender</label>
        <div class="health-calc-toggle-group-{{ custom_selfasesment }}">
          <button
            type="button"
            class="health-calc-toggle-btn-{{ custom_selfasesment }}"
            data-field="gender"
            data-value="male"
          >
            Male
          </button>
          <button
            type="button"
            class="health-calc-toggle-btn-{{ custom_selfasesment }}"
            data-field="gender"
            data-value="female"
          >
            Female
          </button>
          <button
            type="button"
            class="health-calc-toggle-btn-{{ custom_selfasesment }}"
            data-field="gender"
            data-value="other"
          >
            Other
          </button>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="gender">Please select your gender</div>
      </div>

      <div class="health-calc-question-{{ custom_selfasesment }}">
        <label class="health-calc-label-{{ custom_selfasesment }}">Primary Health Goal</label>
        <div class="health-calc-radio-group-{{ custom_selfasesment }}">
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="health_goal" data-field="health_goal" value="weight_loss">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Weight Loss</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="health_goal" data-field="health_goal" value="muscle_gain">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Muscle Gain</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="health_goal" data-field="health_goal" value="general_wellness">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">General Wellness</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="health_goal" data-field="health_goal" value="disease_prevention">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Disease Prevention</span>
          </div>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="health_goal">Please select a health goal</div>
      </div>

      <div class="health-calc-question-{{ custom_selfasesment }}">
        <label class="health-calc-label-{{ custom_selfasesment }}">Culinary Preference</label>
        <div class="health-calc-radio-group-{{ custom_selfasesment }}">
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="culinary_preference" data-field="culinary_preference" value="vegetarian">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Vegetarian</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="culinary_preference" data-field="culinary_preference" value="vegan">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Vegan</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="culinary_preference" data-field="culinary_preference" value="non_vegetarian">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Non-Vegetarian</span>
          </div>
          <div class="health-calc-radio-option-{{ custom_selfasesment }}" data-radio-option>
            <input type="radio" name="culinary_preference" data-field="culinary_preference" value="pescatarian">
            <span class="health-calc-radio-label-{{ custom_selfasesment }}">Pescatarian</span>
          </div>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="culinary_preference">Please select a preference</div>
      </div>

      <div class="health-calc-actions-{{ custom_selfasesment }}">
        <button
          type="button"
          class="health-calc-btn-{{ custom_selfasesment }} health-calc-btn-primary-{{ custom_selfasesment }}"
          data-next-step
        >
          Next
        </button>
      </div>
    </div>

    <div class="health-calc-step-{{ custom_selfasesment }}" data-step="2">
      <div class="health-calc-question-{{ custom_selfasesment }}">
        <h3 class="health-calc-question-title-{{ custom_selfasesment }}">Q1. How often do you consume processed foods?</h3>
        <div class="health-calc-options-grid-{{ custom_selfasesment }}">
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q1"
            data-value="never"
            data-score="0"
          >
            Never
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q1"
            data-value="rarely"
            data-score="5"
          >
            Rarely
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q1"
            data-value="sometimes"
            data-score="10"
          >
            Sometimes
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q1"
            data-value="often"
            data-score="15"
          >
            Often
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q1"
            data-value="daily"
            data-score="20"
          >
            Daily
          </button>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="q1">Please select an option</div>
      </div>

      <div class="health-calc-question-{{ custom_selfasesment }}">
        <h3 class="health-calc-question-title-{{ custom_selfasesment }}">Q2. How many hours do you sleep per night?</h3>
        <div class="health-calc-options-grid-{{ custom_selfasesment }}">
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q2"
            data-value="less_than_5"
            data-score="20"
          >
            Less than 5
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q2"
            data-value="5_to_6"
            data-score="10"
          >
            5-6 hours
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q2"
            data-value="7_to_8"
            data-score="0"
          >
            7-8 hours
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q2"
            data-value="more_than_9"
            data-score="5"
          >
            9+ hours
          </button>
        </div>
        <div class="health-calc-error-{{ custom_selfasesment }}" data-error="q2">Please select an option</div>
      </div>

      <div class="health-calc-question-{{ custom_selfasesment }}">
        <h3 class="health-calc-question-title-{{ custom_selfasesment }}">Q3. How often do you exercise?</h3>
        <div class="health-calc-options-grid-{{ custom_selfasesment }}">
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q3"
            data-value="never"
            data-score="20"
          >
            Never
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q3"
            data-value="rarely"
            data-score="15"
          >
            Rarely
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q3"
            data-value="sometimes"
            data-score="10"
          >
            Sometimes
          </button>
          <button
            type="button"
            class="health-calc-option-btn-{{ custom_selfasesment }}"
            data-question="q3"
            data-value="often"
