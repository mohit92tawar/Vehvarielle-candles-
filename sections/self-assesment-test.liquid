<script>
  (function() {
    class HealthCalcunic extends HTMLElement {
      constructor() {
        super();
        this.currentStep = 1;
        this.totalSteps = 4;
        this.state = {
          age: '',
          age_unit: 'years',
          gender: '',
          health_goal: '',
          culinary_preference: '',
          q1: { value: '', score: 0 },
          q2: { value: '', score: 0 },
          q3: { value: '', score: 0 },
          name: '',
          phone: '',
          email: '',
          totalScore: 0
        };
        this.webhookUrl = this.dataset.webhookUrl || '';
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.querySelectorAll('[data-next-step]').forEach(btn => {
          btn.addEventListener('click', () => this.handleNextStep());
        });

        this.querySelectorAll('[data-prev-step]').forEach(btn => {
          btn.addEventListener('click', () => this.handlePrevStep());
        });

        this.querySelectorAll('[data-submit]').forEach(btn => {
          btn.addEventListener('click', () => this.handleSubmit());
        });

        this.querySelectorAll('[data-field="gender"]').forEach(btn => {
          btn.addEventListener('click', (e) => this.handleToggleSelect(e));
        });

        this.querySelectorAll('[data-radio-option]').forEach(option => {
          option.addEventListener('click', (e) => this.handleRadioSelect(e));
        });

        this.querySelectorAll('[data-question]').forEach(btn => {
          btn.addEventListener('click', (e) => this.handleQuestionSelect(e));
        });

        this.querySelectorAll('[data-field]').forEach(input => {
          if (input.tagName === 'INPUT' || input.tagName === 'SELECT') {
            input.addEventListener('input', (e) => this.handleInputChange(e));
          }
        });

        this.querySelectorAll('[data-modal-close]').forEach(btn => {
          btn.addEventListener('click', () => this.closeModal());
        });
      }

      handleToggleSelect(e) {
        const btn = e.currentTarget;
        const field = btn.dataset.field;
        const value = btn.dataset.value;

        this.querySelectorAll(`[data-field="${field}"]`).forEach(b => {
          b.classList.remove('selected');
        });

        btn.classList.add('selected');
        this.state[field] = value;
        this.hideError(field);
      }

      handleRadioSelect(e) {
        const option = e.currentTarget;
        const radio = option.querySelector('input[type="radio"]');
        const field = radio.dataset.field;

        this.querySelectorAll(`input[name="${radio.name}"]`).forEach(r => {
          r.closest('[data-radio-option]').classList.remove('selected');
        });

        option.classList.add('selected');
        radio.checked = true;
        this.state[field] = radio.value;
        this.hideError(field);
      }

      handleQuestionSelect(e) {
        const btn = e.currentTarget;
        const question = btn.dataset.question;
        const value = btn.dataset.value;
        const score = parseInt(btn.dataset.score);

        this.querySelectorAll(`[data-question="${question}"]`).forEach(b => {
          b.classList.remove('selected');
        });

        btn.classList.add('selected');
        this.state[question] = { value, score };
        this.hideError(question);
      }

      handleInputChange(e) {
        const input = e.currentTarget;
        const field = input.dataset.field;
        this.state[field] = input.value;
        this.hideError(field);
      }

      handleNextStep() {
        if (this.validateStep(this.currentStep)) {
          this.currentStep++;
          this.updateStepDisplay();
          this.updateProgress();
        }
      }

      handlePrevStep() {
        if (this.currentStep > 1) {
          this.currentStep--;
          this.updateStepDisplay();
          this.updateProgress();
        }
      }

      validateStep(step) {
        let isValid = true;

        if (step === 1) {
          if (!this.state.age) {
            this.showError('age');
            isValid = false;
          }
          if (!this.state.gender) {
            this.showError('gender');
            isValid = false;
          }
          if (!this.state.health_goal) {
            this.showError('health_goal');
            isValid = false;
          }
          if (!this.state.culinary_preference) {
            this.showError('culinary_preference');
            isValid = false;
          }
        }

        if (step === 2) {
          if (!this.state.q1.value) {
            this.showError('q1');
            isValid = false;
          }
          if (!this.state.q2.value) {
            this.showError('q2');
            isValid = false;
          }
          if (!this.state.q3.value) {
            this.showError('q3');
            isValid = false;
          }
        }

        if (step === 3) {
          if (!this.state.name) {
            this.showError('name');
            isValid = false;
          }
          if (!this.state.phone) {
            this.showError('phone');
            isValid = false;
          }
          if (!this.state.email || !this.isValidEmail(this.state.email)) {
            this.showError('email');
            isValid = false;
          }
        }

        return isValid;
      }

      isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      showError(field) {
        const errorEl = this.querySelector(`[data-error="${field}"]`);
        if (errorEl) {
          errorEl.classList.add('visible');
        }
      }

      hideError(field) {
        const errorEl = this.querySelector(`[data-error="${field}"]`);
        if (errorEl) {
          errorEl.classList.remove('visible');
        }
      }

      updateStepDisplay() {
        this.querySelectorAll('[data-step]').forEach(step => {
          step.classList.remove('active');
        });

        const currentStepEl = this.querySelector(`[data-step="${this.currentStep}"]`);
        if (currentStepEl) {
          currentStepEl.classList.add('active');
        }

        this.querySelectorAll('[data-step-indicator]').forEach(indicator => {
          const stepNum = parseInt(indicator.dataset.stepIndicator);
          indicator.classList.remove('active', 'completed');

          if (stepNum === this.currentStep) {
            indicator.classList.add('active');
          } else if (stepNum < this.currentStep) {
            indicator.classList.add('completed');
          }
        });
      }

      updateProgress() {
        const progressFill = this.querySelector('[data-progress-fill]');
        const progress = ((this.currentStep - 1) / (this.totalSteps - 1)) * 100;
        if (progressFill) {
          progressFill.style.width = `${progress}%`;
        }
      }

      calculateTotalScore() {
        let total = 0;
        total += this.state.q1.score || 0;
        total += this.state.q2.score || 0;
        total += this.state.q3.score || 0;
        this.state.totalScore = total;
        return total;
      }

      getScoreCategory(score) {
        if (score <= 20) return { text: 'Low Risk', class: 'low' };
        if (score <= 40) return { text: 'Medium Risk', class: 'medium' };
        return { text: 'High Risk', class: 'high' };
      }

      async handleSubmit() {
        if (!this.validateStep(3)) {
          return;
        }

        const totalScore = this.calculateTotalScore();
        const category = this.getScoreCategory(totalScore);

        if (this.webhookUrl) {
          try {
            await fetch(this.webhookUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                ...this.state,
                totalScore,
                category: category.text,
                timestamp: new Date().toISOString()
              })
            });
          } catch (error) {
            console.error('Error sending data:', error);
          }
        }

        this.showScoreModal(totalScore, category);
      }

      showScoreModal(score, category) {
        const modal = this.querySelector('[data-modal]');
        const scoreValue = this.querySelector('[data-score-value]');
        const scoreCategory = this.querySelector('[data-score-category]');
        const gaugeFill = this.querySelector('[data-gauge-fill]');

        if (scoreValue) {
          scoreValue.textContent = score;
        }

        if (scoreCategory) {
          scoreCategory.textContent = category.text;
          scoreCategory.className = `health-calc-score-category-{{ custom_selfasesment }} ${category.class}`;
        }

        if (gaugeFill) {
          const maxScore = 60;
          const percentage = (score / maxScore) * 100;
          const circumference = 502.4;
          const offset = circumference - (circumference * percentage / 100);
          gaugeFill.style.strokeDashoffset = offset;
        }

        if (modal) {
          modal.classList.add('active');
        }
      }

      closeModal() {
        const modal = this.querySelector('[data-modal]');
        if (modal) {
          modal.classList.remove('active');
        }
      }
    }

    customElements.define('health-calc-{{ custom_selfasesment }}', HealthCalcunic);
  })();
</script>

