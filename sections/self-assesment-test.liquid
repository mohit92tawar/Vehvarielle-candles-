            stroke-dasharray="502.4"
            stroke-dashoffset="502.4"
            transform="rotate(-90 100 100)"
            data-gauge-fill
          />
        </svg>
        <div class="health-calc-score-value-{{ custom_selfasesment }}" data-score-value>0</div>
        <div class="health-calc-score-category-{{ custom_selfasesment }}" data-score-category></div>
