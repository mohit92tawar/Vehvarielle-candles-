      "label": "Contact Information URL"
    },
    {
      "type": "url",
      "id": "refund_url",
      "label": "Refund Policy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#3d1f0e"
    },
    {
      "type": "color",
