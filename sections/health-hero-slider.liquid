{% assign custom_health_slider = section.id | replace: '_', '' | downcase %}

{% style %}
.health-slider-nav-{{ custom_health_slider }} svg { width: 34px; height: 34px; }
  .health-slider-{{ custom_health_slider }} {
    position: relative;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    display: none;
  }

  .health-slider-wrapper-{{ custom_health_slider }} {
    position: relative;
    width: 100%;
    max-height: 1006px;
    aspect-ratio: 1.4 / 1;
  }

  .health-slider-track-{{ custom_health_slider }} {
    display: flex;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .health-slider-slide-{{ custom_health_slider }} {
    width: 100%;
    /* position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    opacity: 0;
    transition: opacity {{ section.settings.transition_speed }}s ease-in-out; */
  }

  .health-slider-slide-{{ custom_health_slider }}.active {
    opacity: 1;
    z-index: 1;
  }

  .health-slider-image-{{ custom_health_slider }} {
    /* position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }}; */
  }

  .health-slider-mobile-image-{{ custom_health_slider }} {
    display: none;
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .health-slider-placeholder-{{ custom_health_slider }} {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #7cb342 0%, #558b2f 50%, #33691e 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .health-slider-placeholder-{{ custom_health_slider }} svg {
    width: 100%; height: 100%;
    opacity: 0.15;
  }

  .health-slider-content-{{ custom_health_slider }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 2;
    padding: 46px 66px;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  /* ===== PRODUCT CARD ===== */
  .hs-product-card-{{ custom_health_slider }} {
     /* background: radial-gradient(ellipse at center, #c7c2b9 0%, #e9e7e2 100%); */
     background: #f4ebeb00;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 30px;
    border: 2px solid rgba(255, 255, 255, 0.40);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: 404px;
    /* min-width: 394px;
    max-width: 394px; */
    height: 423px;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.08),
              inset 0 -2px 4px rgba(255, 255, 255, 0.6);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    pointer-events: auto;
    box-sizing: border-box;
  }

  .hs-product-card-{{ custom_health_slider }}:hover {
    /* transform: translateY(-4px); */
    box-shadow: 0 18px 48px rgba(0,0,0,0.18);
  }

  .hs-product-card-{{ custom_health_slider }} * {
    pointer-events: none;
  }

  /* Top row: title+price left, button right */
  .hs-product-card-top-{{ custom_health_slider }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
  }

  .hs-product-card-info-{{ custom_health_slider }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .hs-product-card-title-{{ custom_health_slider }} {
    font-size: 30px;
    font-weight: 700;
    color: #4A2A15;
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hs-product-card-price-{{ custom_health_slider }} {
    font-size: 20px;
    font-weight: 500;
    color: #444;
    margin: 0;
     color: #4A2A15;
  }

  .hs-product-card-btn-{{ custom_health_slider }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    background: transparent;
    color: #4A2A15;
    font-size: 16px;
    font-weight: 500;
    border-radius: 50px;
    border: 1.5px solid #4A2A15;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Product image area */
  .hs-product-card-img-wrap-{{ custom_health_slider }} {
    width: 100%;
    flex: 1;
    background: #F7F6F0;
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 0.40);
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.08),
                inset 0 -2px 4px rgba(255,255,255,0.6);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    min-height: 0;
  }

  .hs-product-card-img-{{ custom_health_slider }} {
    width: auto;
    height: 100%;
    max-height: 220px;
    object-fit: contain;
    display: block;
  }

  /* Nav Arrows */
  .health-slider-nav-{{ custom_health_slider }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background-color: transparent;
    color: {{ section.settings.nav_icon_color }};
    border: none;
    width: {{ section.settings.nav_button_size }}px;
    height: {{ section.settings.nav_button_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    display: none;
  }

  .health-slider-nav-{{ custom_health_slider }}:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .health-slider-nav-prev-{{ custom_health_slider }} { left: {{ section.settings.nav_offset }}px; }
  .health-slider-nav-next-{{ custom_health_slider }} { right: {{ section.settings.nav_offset }}px; }

  /* Dots */
  .health-slider-dots-{{ custom_health_slider }} {
    position: absolute;
    bottom: 17px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: {{ section.settings.dots_spacing }}px;
  }

  .health-slider-dot-{{ custom_health_slider }} {
    cursor: pointer;
    transition: all 0.3s ease;
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    min-width: {{ section.settings.dot_size }}px;
    min-height: {{ section.settings.dot_size }}px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid {{ section.settings.dot_color }};
    background: transparent;
    display: inline-block;
    line-height: 0;
    font-size: 0;
    appearance: none;
    -webkit-appearance: none;
  }

  .health-slider-dot-{{ custom_health_slider }}.active {
    background-color: {{ section.settings.dot_active_color }};
  }

  .health-slider-empty-state-{{ custom_health_slider }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(0,0,0,0.7);
    color: #fff;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    text-align: center;
    pointer-events: none;
    z-index: 4;
  }

  /* ===== MOBILE ===== */
  @media screen and (max-width: 768px) {
    .health-slider-nav-{{ custom_health_slider }} { background-color: transparent; }

    .health-slider-wrapper-{{ custom_health_slider }} {
      aspect-ratio: unset !important;
      height: 62vh;
      max-height: 517px;
    }

    .health-slider-slide-{{ custom_health_slider }}.has-mobile-image .health-slider-image-{{ custom_health_slider }} { display: none; }
    .health-slider-slide-{{ custom_health_slider }}.has-mobile-image .health-slider-mobile-image-{{ custom_health_slider }} { display: block; }

    .health-slider-content-{{ custom_health_slider }} {
      padding: 27px;
       align-items: flex-end;
      justify-content: flex-end;
     /* align-items:center;
      justify-content:center;  */
       padding-bottom: 60px; 
    }

    .health-slider-nav-{{ custom_health_slider }} {
      width: {{ section.settings.nav_button_size }}px;
      height: {{ section.settings.nav_button_size }}px;
    }

    .health-slider-nav-prev-{{ custom_health_slider }} { left: 10px; }
    .health-slider-nav-next-{{ custom_health_slider }} { right: 10px; }

    .hs-product-card-{{ custom_health_slider }} {
      width: 180px;
      min-width: 180px;
      max-width: 180px;
      height: auto;
      min-height: 200px;
      padding: 12px;
      gap: 8px;
      border-radius: 20px;
    }

    .hs-product-card-title-{{ custom_health_slider }} { font-size: 12px; }
    .hs-product-card-price-{{ custom_health_slider }} { font-size: 11px; }
    .hs-product-card-btn-{{ custom_health_slider }} { font-size: 10px; padding: 5px 10px; }
    .hs-product-card-img-wrap-{{ custom_health_slider }} { min-height: 90px; padding: 8px; }
    .hs-product-card-img-{{ custom_health_slider }} { max-height: 100px; }
  }
{% endstyle %}

<health-slider-hero-{{ custom_health_slider }}
  class="health-slider-{{ custom_health_slider }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  {{ section.shopify_attributes }}
>
  <div class="health-slider-wrapper-{{ custom_health_slider }}">
    <div class="health-slider-track-{{ custom_health_slider }}">

      {% assign has_slides = false %}
      {% for block in section.blocks %}

        {% assign slide_image        = block.settings.image %}
        {% assign slide_mobile_image = block.settings.mobile_image %}
        {% assign slide_product      = block.settings.product %}
        {% assign slide_btn_text     = block.settings.product_button_text %}

        {% if slide_image != blank %}
          {% assign has_slides = true %}

          {% assign mobile_class = '' %}
          {% if slide_mobile_image != blank %}
            {% assign mobile_class = ' has-mobile-image' %}
          {% endif %}

          <div class="health-slider-slide-{{ custom_health_slider }}{{ mobile_class }} {% if forloop.first %}active{% endif %}"
               data-slide="{{ forloop.index0 }}"
               {{ block.shopify_attributes }}>

            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="health-slider-image-{{ custom_health_slider }}"
            >

            {% if slide_mobile_image != blank %}
              <img
                src="{{ slide_mobile_image | image_url: width: 1200 }}"
                alt="{{ slide_mobile_image.alt | default: slide_image.alt | escape }}"
                loading="lazy"
                width="{{ slide_mobile_image.width }}"
                height="{{ slide_mobile_image.height }}"
                class="health-slider-mobile-image-{{ custom_health_slider }}"
              >
            {% endif %}

            <div class="health-slider-overlay-{{ custom_health_slider }}"></div>

            <div class="health-slider-content-{{ custom_health_slider }}">

              {% if slide_product != blank %}
                {% assign prod_img   = slide_product.featured_image %}
                {% assign prod_price = slide_product.price | money %}
                {% assign prod_url   = slide_product.url %}

                <a href="{{ prod_url }}" class="hs-product-card-{{ custom_health_slider }}">

                  <div class="hs-product-card-top-{{ custom_health_slider }}">
                    <div class="hs-product-card-info-{{ custom_health_slider }}">
                      <p class="hs-product-card-title-{{ custom_health_slider }}">{{ slide_product.title }}</p>
                      <p class="hs-product-card-price-{{ custom_health_slider }}">{{ prod_price }}</p>
                    </div>
                    <span class="hs-product-card-btn-{{ custom_health_slider }}">
                      {{ slide_btn_text | default: 'Shop now' }}
                    </span>
                  </div>

                  {% if prod_img != blank %}
                    <div class="hs-product-card-img-wrap-{{ custom_health_slider }}">
                      <img
                        src="{{ prod_img | image_url: width: 600 }}"
                        alt="{{ prod_img.alt | default: slide_product.title | escape }}"
                        loading="lazy"
                        width="{{ prod_img.width }}"
                        height="{{ prod_img.height }}"
                        class="hs-product-card-img-{{ custom_health_slider }}"
                      >
                    </div>
                  {% endif %}

                </a>
              {% endif %}

            </div>
          </div>
        {% endif %}

      {% endfor %}

      {% unless has_slides %}
        <div class="health-slider-slide-{{ custom_health_slider }} active" data-slide="0">
          <div class="health-slider-placeholder-{{ custom_health_slider }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
          <div class="health-slider-empty-state-{{ custom_health_slider }}">
            Add images to your slides to get started
          </div>
        </div>
      {% endunless %}
    </div>

    {% if has_slides and section.settings.show_navigation %}
      <button class="health-slider-nav-{{ custom_health_slider }} health-slider-nav-prev-{{ custom_health_slider }}" aria-label="Previous slide">
        {{ 'icon-chevron-left.svg' | inline_asset_content }}
      </button>
      <button class="health-slider-nav-{{ custom_health_slider }} health-slider-nav-next-{{ custom_health_slider }}" aria-label="Next slide">
        {{ 'icon-chevron-right.svg' | inline_asset_content }}
      </button>
    {% endif %}

    {% if has_slides and section.settings.show_dots %}
      <div class="health-slider-dots-{{ custom_health_slider }}"></div>
    {% endif %}

  </div>
</health-slider-hero-{{ custom_health_slider }}>

<script>
  (function() {
    class healthSliderHero extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.style.display = 'block';
        this.slides = this.querySelectorAll('.health-slider-slide-{{ custom_health_slider }}');
        this.totalSlides = this.slides.length;
        if (this.totalSlides <= 1) return;
        this.setupNavigation();
        this.setupDots();
        this.setupAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) clearInterval(this.autoplayInterval);
      }

      setupNavigation() {
        const prevBtn = this.querySelector('.health-slider-nav-prev-{{ custom_health_slider }}');
        const nextBtn = this.querySelector('.health-slider-nav-next-{{ custom_health_slider }}');
        if (prevBtn) prevBtn.addEventListener('click', () => this.goToSlide(this.currentSlide - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => this.goToSlide(this.currentSlide + 1));
      }

      setupDots() {
        const dotsContainer = this.querySelector('.health-slider-dots-{{ custom_health_slider }}');
        if (!dotsContainer) return;
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'health-slider-dot-{{ custom_health_slider }}' + (i === 0 ? ' active' : '');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', () => this.goToSlide(i));
          dotsContainer.appendChild(dot);
        }
        this.dots = dotsContainer.querySelectorAll('.health-slider-dot-{{ custom_health_slider }}');
      }

      setupAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const speed = parseInt(this.dataset.autoplaySpeed) * 1000;
        if (autoplay && speed > 0) {
          this.autoplayInterval = setInterval(() => this.goToSlide(this.currentSlide + 1), speed);
          this.addEventListener('mouseenter', () => clearInterval(this.autoplayInterval));
          this.addEventListener('mouseleave', () => {
            this.autoplayInterval = setInterval(() => this.goToSlide(this.currentSlide + 1), speed);
          });
        }
      }

      goToSlide(index) {
        if (index < 0) index = this.totalSlides - 1;
        else if (index >= this.totalSlides) index = 0;
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots) this.dots[this.currentSlide].classList.remove('active');
        this.currentSlide = index;
        this.slides[this.currentSlide].classList.add('active');
        if (this.dots) this.dots[this.currentSlide].classList.add('active');
      }
    }

    customElements.define('health-slider-hero-{{ custom_health_slider }}', healthSliderHero);
  })();
</script>

{% schema %}
{
  "name": "Health Hero Slider",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ], "default": "center" },
    { "type": "header", "content": "Slider settings" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 0.3, "max": 2, "step": 0.1, "unit": "s", "default": 0.5 },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "header", "content": "Navigation style" },
    { "type": "range", "id": "nav_button_size", "label": "Button size", "min": 30, "max": 60, "step": 5, "unit": "px", "default": 45 },
    { "type": "range", "id": "nav_offset", "label": "Button offset", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "color", "id": "nav_icon_color", "label": "Icon color", "default": "#000000" },
    { "type": "header", "content": "Dots style" },
    { "type": "range", "id": "dot_size", "label": "Dot size", "min": 6, "max": 16, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "dots_spacing", "label": "Spacing", "min": 4, "max": 16, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "dot_color", "label": "Dot color", "default": "#ffffff" },
    { "type": "color", "id": "dot_active_color", "label": "Active dot color", "default": "#7cb342" },
    { "type": "header", "content": "Overlay" },
    { "type": "select", "id": "overlay_style", "label": "Overlay style", "options": [
        { "value": "left_fade", "label": "Left fade" },
        { "value": "right_fade", "label": "Right fade" },
        { "value": "top_fade", "label": "Top fade" },
        { "value": "solid", "label": "Solid" },
        { "value": "none", "label": "None" }
      ], "default": "left_fade" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 1, "step": 0.1, "default": 1 },
    { "type": "header", "content": "Content layout" },
    { "type": "range", "id": "text_area_width", "label": "Text area width", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ], "default": "center" },
    { "type": "range", "id": "content_spacing", "label": "Content spacing", "min": 10, "max": 40, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_vertical", "label": "Vertical padding", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "label": "Horizontal padding", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 40 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 50 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 14, "max": 32, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 12, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#f5f5f5" },
    { "type": "select", "id": "text_shadow", "label": "Text shadow", "options": [
        { "value": "none", "label": "None" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "medium", "label": "Medium" },
        { "value": "strong", "label": "Strong" }
      ], "default": "medium" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" },
        { "type": "header", "content": "Product Card" },
        { "type": "product", "id": "product", "label": "Select Product" },
        { "type": "text", "id": "product_button_text", "label": "Button Text", "default": "Shop now" }
      ]
    }
  ],
  "presets": [
    { "name": "Health Hero Slider" }
  ]
}
{% endschema %}
