{% assign custom_health_slider = section.id | replace: '_', '' | downcase %}

{% style %}
.health-slider-{{ custom_health_slider }} {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.health-slider-wrapper-{{ custom_health_slider }} {
  position: relative;
  width: 100%;
  height: 80vh;
}

.health-slider-slide-{{ custom_health_slider }} {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.health-slider-slide-{{ custom_health_slider }}.active {
  opacity: 1;
}

.health-slider-image-{{ custom_health_slider }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== CONTENT ===== */
.health-slider-content-{{ custom_health_slider }} {
  position: absolute;
  top: 50%;
  left: 8%;
  transform: translateY(-50%);
  max-width: 600px;
  color: white;
}

/* HEADING (big like image) */
.hs-slide-heading-{{ custom_health_slider }} {
  font-size: 56px;
  font-weight: 500;
  line-height: 1.2;
  margin-bottom: 16px;
}

/* DESCRIPTION */
.hs-slide-description-{{ custom_health_slider }} {
  font-size: 18px;
  margin-bottom: 25px;
  opacity: 0.9;
}

/* BUTTON */
.hs-slide-btn-{{ custom_health_slider }} {
  display: inline-block;
  padding: 14px 28px;
  background: #3d4d3d;
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  letter-spacing: 1px;
}
{% endstyle %}

<health-slider-hero-{{ custom_health_slider }} class="health-slider-{{ custom_health_slider }}">
  <div class="health-slider-wrapper-{{ custom_health_slider }}">

    {% for block in section.blocks %}
      <div class="health-slider-slide-{{ custom_health_slider }} {% if forloop.first %}active{% endif %}">

        <img src="{{ block.settings.image | image_url: width: 2000 }}" class="health-slider-image-{{ custom_health_slider }}">

        <div class="health-slider-content-{{ custom_health_slider }}">

          {% if block.settings.subheading != blank %}
            <h2 class="hs-slide-heading-{{ custom_health_slider }}">
              {{ block.settings.subheading }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="hs-slide-description-{{ custom_health_slider }}">
              {{ block.settings.description }}
            </p>
          {% endif %}

          {% if block.settings.product_button_text != blank %}
            <a href="#" class="hs-slide-btn-{{ custom_health_slider }}">
              {{ block.settings.product_button_text }}
            </a>
          {% endif %}

        </div>
      </div>
    {% endfor %}

  </div>
</health-slider-hero-{{ custom_health_slider }}>

<script>
class Slider extends HTMLElement {
  connectedCallback() {
    this.slides = this.querySelectorAll('.health-slider-slide-{{ custom_health_slider }}');
    let i = 0;

    setInterval(() => {
      this.slides[i].classList.remove('active');
      i = (i + 1) % this.slides.length;
      this.slides[i].classList.add('active');
    }, 3000);
  }
}
customElements.define('health-slider-hero-{{ custom_health_slider }}', Slider);
</script>
{% schema %}
{
  "name": "Custom Hero Slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Heading",
          "default": "We’re here to help you feel balanced"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Built for daily life and long-term health. Clean formula — no fillers, no compromise."
        },
        {
          "type": "text",
          "id": "product_button_text",
          "label": "Button Text",
          "default": "START TODAY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Slider"
    }
  ]
}
{% endschema %}